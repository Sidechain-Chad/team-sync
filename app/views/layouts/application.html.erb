<!DOCTYPE html>
<html>
  <head>
    <title>TeamSync</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Golden Hour rebrand type: Bricolage Grotesque (display) + Instrument Sans (body) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <%# Mapbox public token, read by Stimulus controllers via
        document.querySelector('meta[name="mapbox-token"]').content %>
    <meta name="mapbox-token" content="<%= mapbox_public_token %>">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flatpickr", "data-turbo-track": "reload" %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <%# Mapbox GL JS — loaded via CDN as a UMD global (window.mapboxgl).
        data-turbo-track keeps it from re-injecting on Turbo navigation. %>
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" rel="stylesheet" data-turbo-track="reload">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js" data-turbo-track="reload"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <%# Global top nav — renders on every page when the user is signed in.
        The partial itself early-returns on Devise pages where there's no
        current_user, so it's safe to mount unconditionally here. %>
    <%= render "shared/top_nav" %>
    <%= render "shared/flash" %>

    <main id="main-content" class="transition-[padding] duration-200 ease-out">
      <%= yield %>
    </main>

    <% if controller_name == "boards" && %w[show map].include?(action_name) %>
      <%= render "shared/bottom_nav" %>
    <% end %>

    <%= turbo_frame_tag "modal", target: "_top", data: { controller: "modal", action: "turbo:before-render@document->modal#close" } %>
  </body>
</html>
