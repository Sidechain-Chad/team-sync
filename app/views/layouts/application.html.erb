<!DOCTYPE html>
<%# data-theme is the single switch the entire dark palette hangs off (see the
    theme block in app/assets/tailwind/application.css). It goes on <html>, not
    <body>, because Tailwind emits its token values on :root — the override has
    to land on the same element to win the cascade, and being on the root also
    means the theme applies to <body>'s own background before any content
    renders. Rendered server-side from the stored preference so there is no
    first-paint flash. %>
<html data-theme="<%= current_theme %>">
  <head>
    <title>TeamSync</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Mapbox public token, read by Stimulus controllers via
        document.querySelector('meta[name="mapbox-token"]').content. The
        Mapbox GL JS/CSS themselves are NOT loaded here — only boards/map and
        planner/map ever render a map, so board_map_controller.js injects
        and caches them lazily on connect rather than shipping 1.4MB of
        parser-blocking JS to every other page. %>
    <meta name="mapbox-token" content="<%= mapbox_public_token %>">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flatpickr", "data-turbo-track": "reload" %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <%# Per-user notification stream — Notification#after_create_commit
        broadcasts the badge replace to `recipient`, so each signed-in user
        needs their own subscription for that to reach them live. %>
    <%= turbo_stream_from current_user if user_signed_in? %>

    <%# Global top nav — renders on every page when the user is signed in.
        The partial itself early-returns on Devise pages where there's no
        current_user, so it's safe to mount unconditionally here. %>
    <%= render "shared/top_nav" %>
    <%= render "shared/flash" %>

    <main id="main-content" class="transition-[padding] duration-200 ease-out">
      <%= yield %>
    </main>

    <% if controller_name == "boards" && %w[show map].include?(action_name) %>
      <%= render "shared/bottom_nav" %>
    <% end %>

    <%= turbo_frame_tag "modal", target: "_top", data: { controller: "modal", action: "turbo:before-render@document->modal#close" } %>
  </body>
</html>
