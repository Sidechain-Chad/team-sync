<%= turbo_frame_tag "list_#{@list.id}_new_card" do %>
  <div class="bg-white p-2 rounded shadow-sm border-2 border-brand-700 my-2">
    <%= form_with(model: [@list, @card], class: "space-y-2") do |f| %>

      <%= f.text_area :title,
          rows: 2,
          class: "w-full border-line rounded text-sm focus:ring-brand-700 focus:border-brand-700 p-2",
          placeholder: "Enter a title...",
          autofocus: true %>

      <div class="flex items-center justify-between">
        <%= f.submit "Add Card", class: "bg-brand-600 text-white px-3 py-1 rounded text-xs hover:bg-brand-700 cursor-pointer" %>
        <%= link_to "Cancel", board_path(@list.board), class: "text-xs text-ink-500 hover:text-ink-700", data: { turbo_frame: "_top" } %>
      </div>

    <% end %>
  </div>
<% end %>
