<%= turbo_frame_tag dom_id(card, :description) do %>
  <% if card.description.present? %>
    <%# READ MODE: Just text, clicking acts as edit shortcut %>
    <div class="group relative">
      <%= link_to edit_description_card_path(card),
          class: "block w-full text-sm text-gray-700 min-h-[40px] cursor-pointer bg-gray-50 hover:bg-gray-100 rounded-md p-2 transition-colors" do %>

        <div class="tiptap-content text-sm text-gray-700">
          <%
            # Sanitize first, then add target="_blank" + rel="noopener" to all links
            # so clicking opens in a new tab and keeps the user's session safe.
            sanitized = sanitize(card.description,
              tags: %w[h1 h2 h3 h4 h5 h6 p strong em u s code pre blockquote ul ol li a img br hr],
              attributes: %w[href src alt title target rel])

            safe_html = sanitized.gsub(/<a /, '<a target="_blank" rel="noopener noreferrer" ').html_safe
          %>
          <%= safe_html %>
        </div>
      <% end %>
    </div>

  <% else %>
    <%# EMPTY MODE %>
    <%= link_to edit_description_card_path(card),
        class: "block bg-gray-100 hover:bg-gray-200 h-24 rounded-md p-3 text-sm text-gray-500 font-medium transition-colors cursor-pointer flex flex-col justify-start" do %>
      <span class="mb-1">Add a more detailed description...</span>
    <% end %>
  <% end %>
<% end %>
