<% card.members.each do |user| %>
  <%= button_to card_member_path(card, user),
      method: :delete,
      class: "group relative",
      form: { style: "display:inline-block" },
      data: { turbo_confirm: "Remove #{user.display_name} from this card?" } do %>

    <div class="h-6 w-6 rounded-full <%= avatar_soft_classes(user) %> flex items-center justify-center text-[10px] font-bold border ring-1 ring-white cursor-pointer hover:bg-red-100 hover:text-red-600 hover:ring-red-200 transition-all" title="Remove <%= user.display_name %>">
      <%= user.initials %>
    </div>

    <div class="absolute -top-1 -right-1 bg-red-500 text-white rounded-full h-3 w-3 flex items-center justify-center text-[8px] opacity-0 group-hover:opacity-100 transition-opacity">
      <i class="fa-solid fa-xmark"></i>
    </div>

  <% end %>
<% end %>
