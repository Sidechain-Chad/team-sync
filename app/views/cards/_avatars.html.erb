<% card.members.each do |user| %>
  <%= button_to card_member_path(card, user),
      method: :delete,
      class: "group relative focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1 rounded-full",
      form: { style: "display:inline-block" },
      data: { turbo_confirm: "Remove #{user.display_name} from this card?" },
      title: "Remove #{user.display_name}",
      aria: { label: "Remove #{user.display_name} from card" } do %>

    <div class="h-6 w-6 rounded-full <%= avatar_soft_classes(user) %> flex items-center justify-center text-[10px] font-bold border ring-1 ring-white cursor-pointer hover:bg-danger-50 hover:text-danger-600 hover:ring-danger-600/25 transition-all">
      <%= user.initials %>
    </div>

    <div class="absolute -top-1 -right-1 bg-danger-500 text-white rounded-full h-3 w-3 flex items-center justify-center text-[8px] opacity-0 group-hover:opacity-100 transition-opacity">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </div>

  <% end %>
<% end %>
