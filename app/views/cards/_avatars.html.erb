<% card.members.each do |user| %>
  <%= button_to card_member_path(card, user),
      method: :delete,
      class: "group relative h-11 w-11 flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1 rounded-full",
      form: { class: "inline-block" },
      data: { turbo_confirm: "Remove #{user.display_name} from this card?" },
      title: "Remove #{user.display_name}",
      aria: { label: "Remove #{user.display_name} from card" } do %>

    <%= render "shared/avatar", user: user, size: "h-6 w-6", text_size: "text-[10px]",
        css_class: "border ring-1 ring-white cursor-pointer hover:bg-danger-50 hover:text-danger-600 hover:ring-danger-600/25 transition-all" %>

    <%# Pinned to the 24px avatar, not the 44px tap target around it: top-2.5 /
        right-2.5 is the button's 10px padding, then the original -1 offset. %>
    <div class="absolute top-1.5 right-1.5 bg-danger-500 text-white rounded-full h-3 w-3 flex items-center justify-center text-[8px] opacity-0 group-hover:opacity-100 transition-opacity">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </div>

  <% end %>
<% end %>
