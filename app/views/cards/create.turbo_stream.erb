<%# The new card itself is inserted via CardsController#broadcast_card_insert
    (a board-stream broadcast, not rendered here) — the actor is subscribed
    to that same stream, so rendering it in this response too would insert
    it twice. This response only resets the trigger, which IS actor-only. %>
<%= turbo_stream.replace "list_#{@list.id}_new_card" do %>
  <%= link_to new_list_card_path(@list),
      class: "flex items-center gap-2 w-full p-2 text-ink-500 hover:bg-surface-200 rounded text-sm font-medium transition-colors" do %>
    <i class="fa-solid fa-plus text-xs"></i>
    <span>Add a card</span>
  <% end %>
<% end %>
