<%# Insert the new card BEFORE the "Add a card" trigger so the trigger
    stays positioned right after the last card. %>
<%= turbo_stream.before "list_#{@list.id}_new_card" do %>
  <%= render @card %>
<% end %>

<%# Reset the trigger so it's the empty link again, ready for the next card %>
<%= turbo_stream.replace "list_#{@list.id}_new_card" do %>
  <%= link_to new_list_card_path(@list),
      class: "flex items-center gap-2 w-full p-2 text-gray-600 hover:bg-gray-200 rounded text-sm font-medium transition-colors" do %>
    <i class="fa-solid fa-plus text-xs"></i>
    <span>Add a card</span>
  <% end %>
<% end %>
