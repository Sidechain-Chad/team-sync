<%# Inline form for editing or creating a label.
    Local 'card' is used to render the row back into the picker. %>
<%
  is_new = label.new_record?
  url    = is_new ? board_labels_path(board) : board_label_path(board, label)
  method = is_new ? :post : :patch
  frame_id = is_new ? "new_label_row" : "label_row_#{label.id}"
%>

<%= turbo_frame_tag frame_id do %>
  <%= form_with model: label, url: url, method: method,
      data: { turbo_frame: frame_id },
      class: "p-2 bg-gray-50 border border-gray-200 rounded space-y-2" do |f| %>

    <%# Hidden field so the controller knows which card we're editing
        from, in case it needs to render the row back. %>
    <%= hidden_field_tag :card_id, card.id %>

    <%# --- COLOR PREVIEW + NAME INPUT --- %>
    <div>
      <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Title</label>
      <div class="h-8 rounded flex items-center px-3 text-sm font-semibold mb-2 <%= label_solid_class(label.color) %>"
           id="label_form_preview_<%= label.id || 'new' %>">
        <%= label.name.presence || label.color.capitalize %>
      </div>
      <%= f.text_field :name,
          placeholder: "Label name",
          class: "w-full text-sm border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <%# --- COLOR SWATCH GRID --- %>
    <div>
      <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Color</label>
      <div class="grid grid-cols-5 gap-1">
        <% Label::COLORS.each do |color| %>
          <label class="cursor-pointer">
            <%= f.radio_button :color, color, class: "peer sr-only" %>
            <div class="h-7 rounded <%= label_solid_class(color) %> peer-checked:ring-2 peer-checked:ring-offset-1 peer-checked:ring-blue-600 hover:opacity-90"
                 title="<%= color.capitalize %>"></div>
          </label>
        <% end %>
      </div>
    </div>

    <%# --- ACTIONS --- %>
    <div class="flex items-center justify-between gap-2 pt-2 border-t border-gray-200">
      <div class="flex gap-2">
        <%= f.submit (is_new ? "Create" : "Save"),
            class: "bg-blue-600 hover:bg-blue-700 text-white text-xs px-3 py-1.5 rounded cursor-pointer" %>
        <%# Cancel restores the row to its non-edit state %>
        <% if is_new %>
          <%= link_to "Cancel", new_label_cancel_path(card),
              data: { turbo_frame: frame_id },
              class: "text-xs text-gray-600 hover:bg-gray-200 px-2 py-1.5 rounded" %>
        <% else %>
          <%# For edit, "cancel" just re-renders the row %>
          <%= link_to "Cancel", label_row_cancel_path(card, label),
              data: { turbo_frame: frame_id },
              class: "text-xs text-gray-600 hover:bg-gray-200 px-2 py-1.5 rounded" %>
        <% end %>
      </div>

      <% unless is_new %>
        <%= button_to board_label_path(board, label),
            method: :delete,
            data: { turbo_confirm: "Delete this label? It will be removed from any cards using it." },
            class: "text-xs text-red-600 hover:bg-red-50 px-2 py-1.5 rounded m-0",
            form: { class: "m-0", data: { turbo_frame: frame_id } } do %>
          <i class="fa-solid fa-trash text-xs"></i> Delete
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
