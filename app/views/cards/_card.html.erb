<%= turbo_frame_tag card, class: "block", data: { id: card.id, position: card.position } do %>
  <%# Wrapper: relative + group for hover interactions. Filter data
      attributes are read by board_filter_controller.js — they render
      server-side so any turbo-stream re-render (drag, edit, broadcast)
      automatically carries fresh values. data-position is read by
      gap_insert_controller.js so it never has to count DOM nodes (which
      would miscount once filtered/hidden cards are in the mix). Card
      spacing lives on the list container (`space-y-3`, see lists/_list)
      — no margin here, so there's exactly one source of truth for the
      gap. That only works because the frame is forced `block`: a bare
      `<turbo-frame>` defaults to `display: inline`, so `space-y-3`'s
      margin (applied to this frame, not the div inside it) would
      otherwise be a no-op — inline boxes ignore vertical margins. This
      is exactly why the old `mb-2` (on the div below, a real block box)
      was the one actually creating the gap, and the container's
      `space-y-2` was dead weight. Hover/focus is an `outline`, not a
      `ring`: a non-inset `ring` is a box-shadow painted OUTSIDE the
      border box, which (a) reads as a faint halo rather than a lit edge
      against the warm canvas, brand-400 was tuned for, and (b) sits
      behind the card visually since nothing paints over it. `outline`
      paints on top of the box (and, unlike a normal border, doesn't
      affect layout or get clipped by this element's own overflow-hidden
      needed for the cover image's corners), so a negative offset pulls
      it onto the edge itself, over the cover image, in brand-600 for
      real contrast. Modern browsers clip `outline` to the element's
      `border-radius`, so it still follows `rounded-lg` cleanly. No
      transition on the wrapper at all: box-shadow (shadow-md) and
      outline are separate CSS properties here, but transitioning either
      reintroduces the "two cards lit at once" trail a fast sweep
      exposes, so both snap instantly. `focus-within` (not
      `group-focus-within`) since the outline lives on the same element
      that contains the focusable controls. %>
  <div class="bg-white rounded-lg shadow-sm hover:shadow-md group relative border border-transparent hover:outline-2 hover:outline-brand-600 hover:-outline-offset-2 focus-within:outline-2 focus-within:outline-brand-600 focus-within:-outline-offset-2 cursor-grab overflow-hidden"
       data-filter-labels="<%= card.labels.map(&:id).join(' ') %>"
       data-filter-members="<%= card.members.map(&:id).join(' ') %>"
       data-filter-due="<%= card.due_status %>"
       tabindex="-1">

    <%# ============ TOP-RIGHT: contextual quick actions ============
        Dark translucent badges read cleanly over both cover images and white
        card bodies — the same pattern Trello uses. Archive only appears once
        the card is marked complete and gets a more pronounced shadow as the
        "next-step" affordance. %>
    <div class="absolute top-2 right-3 flex items-center gap-1.5 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-200 ease-out z-content">

      <% if card.completed? %>
        <%= button_to archive_card_path(card),
            method: :patch,
            form: {
              class: "m-0",
              data: { turbo_confirm: "Archive this card? You can restore it from the archive view." }
            },
            class: "h-7 w-7 rounded-md bg-ink-900/55 hover:bg-ink-900/75 backdrop-blur-sm text-white flex items-center justify-center shadow-md ring-1 ring-white/10 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1",
            title: "Archive card",
            aria: { label: "Archive card" } do %>
          <i class="fa-solid fa-box-archive text-[11px]" aria-hidden="true"></i>
        <% end %>
      <% end %>

      <%# Keyboard-only twin of the archive button above: the visible one
          only renders once the card is completed (Trello-style "next
          step" affordance), but the `c` shortcut (keyboard_controller.js)
          needs to archive ANY focused card regardless of completion —
          same route/method/confirm, just never shown or reachable by Tab
          (tabindex="-1", aria-hidden) so it changes no visible behavior. %>
      <%= button_to archive_card_path(card),
          method: :patch,
          form: {
            class: "m-0 hidden",
            data: { turbo_confirm: "Archive this card? You can restore it from the archive view." }
          },
          class: "hidden",
          tabindex: "-1",
          aria: { hidden: "true" },
          data: { role: "keyboard-archive" } do %>
      <% end %>

      <%# Inline rename. This pencil used to point at card_path with
          data-turbo-frame="modal" and was labelled "Edit card" — i.e. it did
          exactly what clicking the card body already does (open the modal), so
          it earned no room of its own. It now enters inline title edit instead,
          targeting the tile's OWN title frame; clicking the card body/title
          still opens the modal. %>
      <%= link_to edit_title_card_path(card, context: "tile"),
          data: { turbo_frame: dom_id(card, :tile_title) },
          class: "h-7 w-7 rounded-md bg-ink-900/40 hover:bg-ink-900/60 backdrop-blur-sm text-white flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1",
          title: "Rename card",
          "aria-label": "Rename card" do %>
        <i class="fa-solid fa-pencil text-[11px]" aria-hidden="true"></i>
      <% end %>
    </div>

    <%# ============ COVER IMAGE (separate link) ============ %>
    <% if (cover_url = card_cover_url(card)) %>
      <%= link_to card_path(card),
          data: { turbo_frame: "modal" },
          class: "block bg-surface-200" do %>
        <%= image_tag cover_url, class: "w-full h-[100px] object-cover block", loading: "lazy" %>
      <% end %>
    <% end %>

    <%# ============ CARD BODY ============ %>
    <div class="p-3">

      <%# Labels + due (separate link) %>
      <% if card.labels.any? || card.due_date.present? %>
        <%= link_to card_path(card),
            data: { turbo_frame: "modal" },
            class: "block no-underline text-inherit mb-2" do %>
          <div class="flex flex-wrap gap-1">
            <%= render "cards/label_pills", card: card %>
            <%= render "cards/due_pill",    card: card %>
          </div>
        <% end %>
      <% end %>

      <%# ====== TITLE ROW with inline complete toggle ======
          The toggle is a SIBLING of the title link, not nested inside it,
          which avoids invalid nested-form HTML. The flex layout makes the
          title flow naturally right as the toggle column expands. %>
      <div class="flex items-start gap-0">

        <% if card.completed? %>
          <%# Always visible — green filled check, click to un-complete %>
          <%= button_to toggle_complete_card_path(card),
              method: :patch,
              form: { class: "m-0 shrink-0 mr-1.5 mt-px" },
              class: "h-5 w-5 rounded-full bg-success-600/90 hover:bg-success-600 border-2 border-success-600 flex items-center justify-center transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1#{" animate-complete-pop" if local_assigns.fetch(:just_completed, false)}",
              title: "Mark incomplete",
              aria: { label: "Mark incomplete" } do %>
            <i class="fa-solid fa-check text-[10px] text-white" aria-hidden="true"></i>
          <% end %>
        <% else %>
          <%# Hover-only — empty circle, animates from 0 width to ~26px.
              The wrapper handles width animation; the button inside fades
              in via opacity on the same timing/duration, so the circle
              eases into view as the space opens rather than popping in
              the instant the wrapper is wide enough to show it. Also
              expands on focus-within so the button is reachable (and its
              focus ring visible) via keyboard, not just mouse hover. This
              is deliberately the one reveal on the card slow enough to
              notice — the ring above it stays instant, and a fast sweep
              must still show no title-wobble trail; if 250ms ever
              reintroduces that, drop back to 200. %>
          <div class="shrink-0 overflow-hidden transition-[width] duration-[250ms] ease-in-out w-0 group-hover:w-[26px] group-focus-within:w-[26px]">
            <%= button_to toggle_complete_card_path(card),
                method: :patch,
                form: { class: "m-0 mt-px" },
                class: "h-5 w-5 rounded-full bg-white border-2 border-line hover:border-success-600 hover:bg-success-100 flex items-center justify-center cursor-pointer group/btn opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition duration-[250ms] ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1",
                title: "Mark complete",
                aria: { label: "Mark complete" } do %>
              <i class="fa-solid fa-check text-[10px] text-transparent group-hover/btn:text-success-600" aria-hidden="true"></i>
            <% end %>
          </div>
        <% end %>

        <%# Title — its own turbo frame (flex-1 so it fills the rest of the row),
            swapped for an inline edit form by the pencil above. %>
        <%= render "cards/tile_title", card: card %>
      </div>

      <%# Description + bottom strip (separate link) %>
      <%= link_to card_path(card),
          data: { turbo_frame: "modal" },
          class: "block no-underline text-inherit" do %>

        <% if card.description.present? %>
          <p class="text-xs text-ink-500 mt-1 line-clamp-2">
            <%= strip_tags(card.description).truncate(100) %>
          </p>
        <% end %>

        <%
          comment_count    = card.comments.size
          attachment_count = card.attachments.attached? ? card.attachments.size : 0
          # Both sum blocks iterate the eager-loaded checklist_items in Ruby —
          # do NOT swap items_done back to a `.where(...)` scope, that bypasses
          # the loaded association and reintroduces a query per checklist.
          items_total      = card.checklists.sum { |cl| cl.checklist_items.size }
          items_done       = card.checklists.sum { |cl| cl.checklist_items.count(&:completed?) }

          has_status  = card.description.present? || comment_count.positive? ||
                        attachment_count.positive? || items_total.positive? ||
                        card.location?
          has_members = card.members.any?
        %>
        <%# The strip renders unconditionally now, because the watch badge inside
            it always ships (see below) and has to have somewhere to live. When
            there's nothing else to show it's `hidden` AND marked "empty", which is
            the only case watch_badge_controller is allowed to unhide — otherwise a
            bare card would grow a stray bordered row. A card with real badges is
            marked "filled" and the controller leaves the strip alone. %>
        <% strip_state = (has_status || has_members) ? "filled" : "empty" %>
        <div class="mt-3 flex justify-between items-center border-t border-line pt-2 <%= "hidden" if strip_state == "empty" %>"
             data-watch-badge-strip="<%= strip_state %>">

            <div class="flex items-center gap-3 text-xs text-ink-500">
              <% if card.description.present? %>
                <i class="fa-solid fa-align-left" title="Has description"></i>
              <% end %>
              <% if comment_count.positive? %>
                <span class="flex items-center gap-1" title="<%= comment_count %> comment(s)">
                  <i class="fa-regular fa-comment"></i><%= comment_count %>
                </span>
              <% end %>
              <% if attachment_count.positive? %>
                <span class="flex items-center gap-1" title="<%= attachment_count %> attachment(s)">
                  <i class="fa-solid fa-paperclip"></i><%= attachment_count %>
                </span>
              <% end %>
              <% if card.location? %>
                <i class="fa-solid fa-location-dot"
                   title="<%= card.location_name %>"></i>
              <% end %>
              <% if items_total.positive? %>
                <span class="flex items-center gap-1 <%= 'text-success-600 bg-success-100 px-1.5 py-0.5 rounded' if items_done == items_total %>"
                      title="Checklist progress">
                  <i class="fa-solid fa-square-check"></i><%= items_done %>/<%= items_total %>
                </span>
              <% end %>

              <%# WATCH BADGE — always rendered, always hidden, NO current_user.
                  This partial is broadcast to the BOARD stream through
                  ApplicationController.renderer, which has no session: inside a
                  broadcast render current_user is nil. A `card.watched_by?
                  (current_user)` here would either raise (breaking every tile
                  broadcast in the app — edits, moves, labels, members,
                  attachments, checklists) or quietly render "not watching" for
                  everyone, so a watcher's eye would vanish the moment anybody
                  touched the card and come back on reload.
                  So: one code path, byte-identical for every viewer, and
                  visibility decided client-side by watch_badge_controller against
                  the per-user id set in #watched_cards. There is a test asserting
                  this file contains no current_user, and another asserting the
                  broadcast body is identical for a watcher and a non-watcher. %>
              <span class="hidden items-center gap-1"
                    data-controller="watch-badge"
                    data-watch-badge-card-id-value="<%= card.id %>"
                    title="You're watching this card">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                <span class="sr-only">Watching this card</span>
              </span>
            </div>

            <% if has_members %>
              <div class="flex items-center gap-1">
                <% card.members.first(3).each do |member| %>
                  <%= render "shared/avatar", user: member, size: "h-6 w-6", text_size: "text-[10px]", css_class: "border", title: member.display_name %>
                <% end %>
                <% if card.members.size > 3 %>
                  <div class="h-6 w-6 rounded-full bg-surface-200 flex items-center justify-center text-ink-500 text-[10px] font-bold border border-line" title="<%= card.members.size %> members">
                    +<%= card.members.size - 3 %>
                  </div>
                <% end %>
              </div>
            <% end %>

        </div>

      <% end %>

    </div>
  </div>
<% end %>
