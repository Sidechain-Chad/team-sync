<%= turbo_frame_tag card,
    class: "bg-white p-3 rounded shadow-sm cursor-move hover:bg-gray-50 mb-2 group relative block border border-transparent hover:border-gray-200 transition-all",
    data: { id: card.id } do %>

  <%# Label pills + due date (above the title, like Trello) %>
    <% if card.labels.any? || card.due_date.present? %>
      <div class="flex flex-wrap gap-1 mb-2">
        <%= render "cards/label_pills", card: card %>
        <%= render "cards/due_pill",    card: card %>
      </div>
    <% end %>

  <div class="flex justify-between items-start">

    <div class="flex-1 pr-2">
      <h4 class="text-sm font-medium text-gray-800 leading-tight">
        <%= link_to card.title, card_path(card), class: "hover:text-blue-600 hover:underline", data: { turbo_frame: "modal" } %>
      </h4>
      <% if card.description.present? %>
        <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= strip_tags(card.description).truncate(100) %></p>
      <% end %>
    </div>

    <div class="hidden group-hover:flex space-x-2 bg-white/90 px-1 rounded absolute top-2 right-2 shadow-sm border">
      <%= link_to edit_card_path(card), class: "text-blue-500 hover:text-blue-700 px-1 py-0.5", data: { turbo_frame: dom_id(card) } do %>
         <i class="fa-solid fa-pencil text-xs"></i>
      <% end %>

      <%= link_to card_path(card), class: "text-red-500 hover:text-red-700 px-1 py-0.5", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } do %>
         <i class="fa-solid fa-trash text-xs"></i>
      <% end %>
    </div>

  </div>

  <%# Bottom strip — only renders if there's something to show.
      Shows status icons (Trello-style) on the left, member avatars on the right. %>
  <%
    has_status = card.description.present? ||
                 card.comments.any? ||
                 card.checklists.any? ||
                 card.attachments.attached?
    has_members = card.members.any?
  %>
  <% if has_status || has_members %>
    <div class="mt-3 flex justify-between items-center border-t border-gray-100 pt-2">

      <%# Left side: status icons %>
      <div class="flex items-center gap-3 text-xs text-gray-500">
        <% if card.description.present? %>
          <i class="fa-solid fa-align-left" title="Has description"></i>
        <% end %>
        <% if card.comments.any? %>
          <span class="flex items-center gap-1" title="<%= card.comments.size %> comment(s)">
            <i class="fa-regular fa-comment"></i><%= card.comments.size %>
          </span>
        <% end %>
        <% if card.attachments.attached? %>
          <span class="flex items-center gap-1" title="<%= card.attachments.attached? ? card.attachments.size : 0 %> attachment(s)">
            <i class="fa-solid fa-paperclip"></i><%= card.attachments.attached? ? card.attachments.size : 0 %>
          </span>
        <% end %>
        <% if card.checklists.any? %>
          <% total = card.checklists.sum { |cl| cl.checklist_items.size } %>
          <% done  = card.checklists.sum { |cl| cl.checklist_items.where(completed: true).count } %>
          <% if total.positive? %>
            <span class="flex items-center gap-1 <%= 'text-green-600 bg-green-50 px-1.5 py-0.5 rounded' if done == total %>"
                  title="Checklist progress">
              <i class="fa-solid fa-square-check"></i><%= done %>/<%= total %>
            </span>
          <% end %>
        <% end %>
      </div>

      <%# Right side: member avatars (only if any) %>
      <% if has_members %>
        <div class="flex items-center gap-1">
          <% card.members.first(3).each do |member| %>
            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-[10px] font-bold border border-blue-200" title="<%= member.display_name %>">
              <%= member.initials %>
            </div>
          <% end %>
          <% if card.members.size > 3 %>
            <div class="h-6 w-6 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 text-[10px] font-bold border border-gray-200" title="<%= card.members.size %> members">
              +<%= card.members.size - 3 %>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
  <% end %>

<% end %>
