<%= turbo_frame_tag card, data: { id: card.id } do %>
  <%# Wrapper: relative + group for hover icon positioning. The horizontal
      slide on hover is the small motion Trello uses — translate-x-1 nudges
      the card 4px to the right; transitions back to 0 on mouse-out. %>
  <div class="bg-white rounded shadow-sm hover:shadow-md mb-2 group relative border border-transparent hover:border-gray-300 transition-all duration-150 ease-out hover:translate-x-1 cursor-pointer">

    <%# ============ TOP-LEFT: complete toggle ============
        Two states. Both are buttons so they POST/DELETE on click. The CSS
        decides which one is visible based on whether card.completed?.

        Not complete → empty circle, only visible on card hover. Click marks
                        the card complete (no archive, no confirmation).
        Complete     → filled green check, ALWAYS visible. Click un-marks.
    %>
    <% if card.completed? %>
      <%= button_to toggle_complete_card_path(card),
          method: :patch,
          form: { class: "absolute top-2 left-2 z-10 m-0" },
          class: "h-6 w-6 rounded-full bg-green-500 hover:bg-green-600 border-2 border-green-500 flex items-center justify-center transition-colors shadow-sm cursor-pointer",
          title: "Mark incomplete" do %>
        <i class="fa-solid fa-check text-[11px] text-white"></i>
      <% end %>
    <% else %>
      <%= button_to toggle_complete_card_path(card),
          method: :patch,
          form: { class: "absolute top-2 left-2 z-10 m-0 opacity-0 group-hover:opacity-100 transition-opacity" },
          class: "h-6 w-6 rounded-full bg-white/90 backdrop-blur-sm border-2 border-gray-300 hover:border-green-500 hover:bg-green-50 flex items-center justify-center transition-colors shadow-sm cursor-pointer group/btn",
          title: "Mark complete" do %>
        <i class="fa-solid fa-check text-[11px] text-transparent group-hover/btn:text-green-500"></i>
      <% end %>
    <% end %>

    <%# ============ TOP-RIGHT: contextual quick actions ============
        Always shows the edit pencil on hover. The archive icon only appears
        once the card is marked complete — it's the natural next step. %>
    <div class="absolute top-2 right-2 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity z-10">

      <% if card.completed? %>
        <%= button_to archive_card_path(card),
            method: :patch,
            form: {
              class: "m-0",
              data: { turbo_confirm: "Archive this card? You can restore it from the archive view." }
            },
            class: "h-6 w-6 rounded bg-white/90 backdrop-blur-sm border border-gray-200 hover:bg-yellow-50 hover:text-yellow-700 hover:border-yellow-300 flex items-center justify-center text-gray-500 shadow-sm cursor-pointer",
            title: "Archive card" do %>
          <i class="fa-solid fa-box-archive text-xs"></i>
        <% end %>
      <% end %>

      <%= link_to card_path(card),
          data: { turbo_frame: "modal" },
          class: "h-6 w-6 rounded bg-white/90 backdrop-blur-sm border border-gray-200 hover:bg-gray-100 hover:text-gray-900 flex items-center justify-center text-gray-500 shadow-sm",
          title: "Edit card" do %>
        <i class="fa-solid fa-pencil text-xs"></i>
      <% end %>
    </div>

    <%# ============ CARD BODY ============
        Wrapped in link_to so clicking anywhere outside the hover icons
        opens the full card modal. %>
    <%= link_to card_path(card),
        data: { turbo_frame: "modal" },
        class: "block no-underline text-inherit" do %>

      <% if (cover_url = card_cover_url(card)) %>
        <div class="rounded-t overflow-hidden bg-gray-100">
          <%= image_tag cover_url, class: "w-full h-[100px] object-cover block", loading: "lazy" %>
        </div>
      <% end %>

      <div class="p-3">

        <% if card.labels.any? || card.due_date.present? %>
          <div class="flex flex-wrap gap-1 mb-2">
            <%= render "cards/label_pills", card: card %>
            <%= render "cards/due_pill",    card: card %>
          </div>
        <% end %>

        <%# Title — left padding when complete makes room for the permanent
            green check sitting absolute in the top-left. %>
        <h4 class="text-sm font-medium text-gray-800 leading-tight <%= 'pl-8' if card.completed? %>">
          <%= card.title %>
        </h4>

        <% if card.description.present? %>
          <p class="text-xs text-gray-500 mt-1 line-clamp-2">
            <%= strip_tags(card.description).truncate(100) %>
          </p>
        <% end %>

        <%
          comment_count    = card.comments.size
          attachment_count = card.attachments.attached? ? card.attachments.size : 0
          items_total      = card.checklists.sum { |cl| cl.checklist_items.size }
          items_done       = card.checklists.sum { |cl| cl.checklist_items.where(completed: true).count }

          has_status  = card.description.present? || comment_count.positive? ||
                        attachment_count.positive? || items_total.positive?
          has_members = card.members.any?
        %>
        <% if has_status || has_members %>
          <div class="mt-3 flex justify-between items-center border-t border-gray-100 pt-2">

            <div class="flex items-center gap-3 text-xs text-gray-500">
              <% if card.description.present? %>
                <i class="fa-solid fa-align-left" title="Has description"></i>
              <% end %>
              <% if comment_count.positive? %>
                <span class="flex items-center gap-1" title="<%= comment_count %> comment(s)">
                  <i class="fa-regular fa-comment"></i><%= comment_count %>
                </span>
              <% end %>
              <% if attachment_count.positive? %>
                <span class="flex items-center gap-1" title="<%= attachment_count %> attachment(s)">
                  <i class="fa-solid fa-paperclip"></i><%= attachment_count %>
                </span>
              <% end %>
              <% if items_total.positive? %>
                <span class="flex items-center gap-1 <%= 'text-green-700 bg-green-50 px-1.5 py-0.5 rounded' if items_done == items_total %>"
                      title="Checklist progress">
                  <i class="fa-solid fa-square-check"></i><%= items_done %>/<%= items_total %>
                </span>
              <% end %>
            </div>

            <% if has_members %>
              <div class="flex items-center gap-1">
                <% card.members.first(3).each do |member| %>
                  <div class="h-6 w-6 rounded-full <%= avatar_soft_classes(member) %> flex items-center justify-center text-[10px] font-bold border" title="<%= member.display_name %>">
                    <%= member.initials %>
                  </div>
                <% end %>
                <% if card.members.size > 3 %>
                  <div class="h-6 w-6 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 text-[10px] font-bold border border-gray-200" title="<%= card.members.size %> members">
                    +<%= card.members.size - 3 %>
                  </div>
                <% end %>
              </div>
            <% end %>

          </div>
        <% end %>

      </div>
    <% end %>
  </div>
<% end %>
