<%= turbo_frame_tag card, data: { id: card.id } do %>
  <%# Wrapper: relative + group for hover interactions. %>
  <div class="bg-white rounded shadow-sm hover:shadow-md mb-2 group relative border border-transparent hover:border-gray-300 transition-all duration-150 ease-out cursor-grab overflow-hidden">

    <%# ============ TOP-RIGHT: contextual quick actions ============
        Dark translucent badges read cleanly over both cover images and white
        card bodies — the same pattern Trello uses. Archive only appears once
        the card is marked complete and gets a more pronounced shadow as the
        "next-step" affordance. %>
    <div class="absolute top-2 right-3 flex items-center gap-1.5 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity z-10">

      <% if card.completed? %>
        <%= button_to archive_card_path(card),
            method: :patch,
            form: {
              class: "m-0",
              data: { turbo_confirm: "Archive this card? You can restore it from the archive view." }
            },
            class: "h-7 w-7 rounded-md bg-black/55 hover:bg-black/75 backdrop-blur-sm text-white flex items-center justify-center shadow-md ring-1 ring-white/10 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1",
            title: "Archive card",
            aria: { label: "Archive card" } do %>
          <i class="fa-solid fa-box-archive text-[11px]" aria-hidden="true"></i>
        <% end %>
      <% end %>

      <%= link_to card_path(card),
          data: { turbo_frame: "modal" },
          class: "h-7 w-7 rounded-md bg-black/40 hover:bg-black/60 backdrop-blur-sm text-white flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1",
          title: "Edit card",
          "aria-label": "Edit card" do %>
        <i class="fa-solid fa-pencil text-[11px]" aria-hidden="true"></i>
      <% end %>
    </div>

    <%# ============ COVER IMAGE (separate link) ============ %>
    <% if (cover_url = card_cover_url(card)) %>
      <%= link_to card_path(card),
          data: { turbo_frame: "modal" },
          class: "block bg-gray-100" do %>
        <%= image_tag cover_url, class: "w-full h-[100px] object-cover block", loading: "lazy" %>
      <% end %>
    <% end %>

    <%# ============ CARD BODY ============ %>
    <div class="p-3">

      <%# Labels + due (separate link) %>
      <% if card.labels.any? || card.due_date.present? %>
        <%= link_to card_path(card),
            data: { turbo_frame: "modal" },
            class: "block no-underline text-inherit mb-2" do %>
          <div class="flex flex-wrap gap-1">
            <%= render "cards/label_pills", card: card %>
            <%= render "cards/due_pill",    card: card %>
          </div>
        <% end %>
      <% end %>

      <%# ====== TITLE ROW with inline complete toggle ======
          The toggle is a SIBLING of the title link, not nested inside it,
          which avoids invalid nested-form HTML. The flex layout makes the
          title flow naturally right as the toggle column expands. %>
      <div class="flex items-start gap-0">

        <% if card.completed? %>
          <%# Always visible — green filled check, click to un-complete %>
          <%= button_to toggle_complete_card_path(card),
              method: :patch,
              form: { class: "m-0 shrink-0 mr-1.5 mt-px" },
              class: "h-5 w-5 rounded-full bg-green-500 hover:bg-green-600 border-2 border-green-500 flex items-center justify-center transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1",
              title: "Mark incomplete",
              aria: { label: "Mark incomplete" } do %>
            <i class="fa-solid fa-check text-[10px] text-white" aria-hidden="true"></i>
          <% end %>
        <% else %>
          <%# Hover-only — empty circle, animates from 0 width to ~26px.
              The wrapper handles width animation; the button inside is
              fixed-size and visible only after the wrapper has expanded.
              Also expands on focus-within so the button is reachable (and
              its focus ring visible) via keyboard, not just mouse hover. %>
          <div class="shrink-0 overflow-hidden transition-[width] duration-150 ease-out w-0 group-hover:w-[26px] group-focus-within:w-[26px]">
            <%= button_to toggle_complete_card_path(card),
                method: :patch,
                form: { class: "m-0 mt-px" },
                class: "h-5 w-5 rounded-full bg-white border-2 border-gray-300 hover:border-green-500 hover:bg-green-50 flex items-center justify-center transition-colors cursor-pointer group/btn focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1",
                title: "Mark complete",
                aria: { label: "Mark complete" } do %>
              <i class="fa-solid fa-check text-[10px] text-transparent group-hover/btn:text-green-500" aria-hidden="true"></i>
            <% end %>
          </div>
        <% end %>

        <%# Title — flex-1 so it fills the rest of the row %>
        <%= link_to card_path(card),
            data: { turbo_frame: "modal" },
            class: "flex-1 no-underline text-inherit min-w-0" do %>
          <h4 class="text-sm font-medium text-gray-800 leading-tight"><%= card.title %></h4>
        <% end %>
      </div>

      <%# Description + bottom strip (separate link) %>
      <%= link_to card_path(card),
          data: { turbo_frame: "modal" },
          class: "block no-underline text-inherit" do %>

        <% if card.description.present? %>
          <p class="text-xs text-gray-500 mt-1 line-clamp-2">
            <%= strip_tags(card.description).truncate(100) %>
          </p>
        <% end %>

        <%
          comment_count    = card.comments.size
          attachment_count = card.attachments.attached? ? card.attachments.size : 0
          # Both sum blocks iterate the eager-loaded checklist_items in Ruby —
          # do NOT swap items_done back to a `.where(...)` scope, that bypasses
          # the loaded association and reintroduces a query per checklist.
          items_total      = card.checklists.sum { |cl| cl.checklist_items.size }
          items_done       = card.checklists.sum { |cl| cl.checklist_items.count(&:completed?) }

          has_status  = card.description.present? || comment_count.positive? ||
                        attachment_count.positive? || items_total.positive? ||
                        card.location?
          has_members = card.members.any?
        %>
        <% if has_status || has_members %>
          <div class="mt-3 flex justify-between items-center border-t border-gray-100 pt-2">

            <div class="flex items-center gap-3 text-xs text-gray-500">
              <% if card.description.present? %>
                <i class="fa-solid fa-align-left" title="Has description"></i>
              <% end %>
              <% if comment_count.positive? %>
                <span class="flex items-center gap-1" title="<%= comment_count %> comment(s)">
                  <i class="fa-regular fa-comment"></i><%= comment_count %>
                </span>
              <% end %>
              <% if attachment_count.positive? %>
                <span class="flex items-center gap-1" title="<%= attachment_count %> attachment(s)">
                  <i class="fa-solid fa-paperclip"></i><%= attachment_count %>
                </span>
              <% end %>
              <% if card.location? %>
                <i class="fa-solid fa-location-dot"
                   title="<%= card.location_name %>"></i>
              <% end %>
              <% if items_total.positive? %>
                <span class="flex items-center gap-1 <%= 'text-green-700 bg-green-50 px-1.5 py-0.5 rounded' if items_done == items_total %>"
                      title="Checklist progress">
                  <i class="fa-solid fa-square-check"></i><%= items_done %>/<%= items_total %>
                </span>
              <% end %>
            </div>

            <% if has_members %>
              <div class="flex items-center gap-1">
                <% card.members.first(3).each do |member| %>
                  <div class="h-6 w-6 rounded-full <%= avatar_soft_classes(member) %> flex items-center justify-center text-[10px] font-bold border" title="<%= member.display_name %>">
                    <%= member.initials %>
                  </div>
                <% end %>
                <% if card.members.size > 3 %>
                  <div class="h-6 w-6 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 text-[10px] font-bold border border-gray-200" title="<%= card.members.size %> members">
                    +<%= card.members.size - 3 %>
                  </div>
                <% end %>
              </div>
            <% end %>

          </div>
        <% end %>

      <% end %>

    </div>
  </div>
<% end %>
