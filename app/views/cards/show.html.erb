<%
  # Where closing this modal lands — the card's board normally, but back
  # to the account Cards page (sort preserved) when that's where it was
  # opened from. @return_to_account/@return_to_sort come from a strict
  # whitelist (CardsController#resolve_return_to!), never a reflected path.
  close_path = @return_to_account ? account_cards_path(sort: @return_to_sort) : board_path(@card.list.board)
%>
<%# This MUST mirror the canonical modal frame in
    layouts/application.html.erb — CardsController#update replaces this whole
    frame via turbo_stream.replace("modal", template: "cards/show"), so any
    attribute missing here (notably target: "_top" and the modal close
    controller) is silently dropped after an attach/move/location change,
    breaking the next modal close ("Content missing"). Keep the two in sync. %>
<%= turbo_frame_tag "modal", target: "_top",
      data: { controller: "modal", action: "turbo:before-render@document->modal#close" } do %>
  <div class="fixed inset-0 z-[9999] flex items-center justify-center">

    <%# Overlay (clicking it closes the modal, same destination as ✕) %>
    <%= link_to close_path,
        class: "absolute inset-0 bg-ink-900/60 cursor-default",
        data: { turbo_action: "advance", modal_exit: true } do %>
    <% end %>

    <%# THE MODAL BOX %>
    <div class="relative z-[10000] bg-surface-100 w-full max-w-6xl h-[90vh] rounded-lg shadow-2xl flex flex-col text-ink-700 m-4 pointer-events-auto"
         role="dialog"
         aria-modal="true"
         aria-labelledby="card_modal_title_<%= @card.id %>"
         tabindex="-1"
         data-modal-target="dialog">

      <%# =========================================================== %>
      <%# HEADER — the list chip is the Move card control (Trello     %>
      <%# position): click it to open a popover with List + Position  %>
      <%# selects. On the right, the ⋯ menu holds Archive (the only   %>
      <%# archive control in the modal), then Close.                  %>
      <%# =========================================================== %>
      <div class="flex items-center justify-between px-6 py-4 border-b border-line bg-surface-100 rounded-t-lg shrink-0 z-20 relative">

        <%
          list_card_counts = @card.list.board.lists.each_with_object({}) do |list, counts|
            counts[list.id] = list.active_cards.count
          end
        %>
        <div class="relative"
             data-controller="dropdown move-picker"
             data-action="click@window->dropdown#hide"
             data-move-picker-counts-value="<%= list_card_counts.to_json %>"
             data-move-picker-current-list-id-value="<%= @card.list_id %>"
             data-move-picker-current-position-value="<%= @card.position %>">

          <button type="button" data-action="click->dropdown#toggle"
                  aria-haspopup="true"
                  aria-label="Move card, currently in <%= @card.list.name %>"
                  class="flex items-center gap-2 bg-surface-200 hover:bg-surface-300 px-3 py-1.5 rounded text-sm font-semibold text-ink-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1">
            <span>in <%= @card.list.name %></span>
            <i class="fa-solid fa-chevron-down text-[10px] opacity-70" aria-hidden="true"></i>
          </button>

          <div data-dropdown-target="menu"
               class="hidden absolute left-0 top-full mt-2 w-72 bg-white border border-line rounded-lg shadow-xl z-30 p-3 flex flex-col gap-3">
            <div class="text-center text-xs font-bold text-ink-500 border-b border-line pb-2">Move card</div>

            <%= form_with model: @card, url: card_path(@card), method: :patch, class: "space-y-3" do |f| %>
              <div>
                <%= f.label :list_id, "List", class: "block text-xs font-medium text-ink-500 mb-1" %>
                <%= f.collection_select :list_id,
                    @card.list.board.lists.order(:position),
                    :id, :name,
                    { selected: @card.list_id },
                    { data: { move_picker_target: "listSelect", action: "change->move-picker#refreshPositions" },
                      class: "w-full text-sm border border-line rounded px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-700" } %>
              </div>

              <div>
                <%= label_tag "card_move_position", "Position", class: "block text-xs font-medium text-ink-500 mb-1" %>
                <%= select_tag "card[position]", nil,
                    id: "card_move_position",
                    data: { move_picker_target: "positionSelect" },
                    class: "w-full text-sm border border-line rounded px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-700" %>
              </div>

              <%= f.submit "Move",
                  class: "w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-1.5 rounded text-sm cursor-pointer shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1" %>
            <% end %>
          </div>
        </div>

        <%# RIGHT: card-actions (⋯) menu, then Close %>
        <div class="flex items-center gap-1">

          <%# Card actions — ONE anchored popover under the ⋯ button, with
              two internal panels that are never both visible at once:
              the menu items (Copy/Archive) and the Copy-card form. Toggled
              by card_actions_menu_controller.js, not a separate floating
              panel. #reset (fired alongside dropdown#toggle on every click
              of the ⋯ button) snaps back to the menu panel whenever the
              popover is freshly opened, so a previous "Copy card" session
              never lingers into the next open. %>
          <div class="relative" data-controller="dropdown card-actions-menu" data-action="click@window->dropdown#hide">
            <button type="button" data-action="click->dropdown#toggle click->card-actions-menu#reset"
                    aria-haspopup="true"
                    aria-label="Card actions"
                    class="h-8 w-8 flex items-center justify-center rounded text-ink-500 hover:text-ink-700 hover:bg-surface-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1">
              <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
            </button>

            <div id="card_actions_menu"
                 data-dropdown-target="menu"
                 class="hidden absolute right-0 top-full mt-2 w-64 bg-white border border-line rounded-lg shadow-xl z-30 overflow-hidden">

              <%# --- Menu panel --- %>
              <div data-card-actions-menu-target="menu">
                <button type="button" data-action="click->card-actions-menu#showCopyForm"
                        class="w-full text-left bg-white hover:bg-surface-200 text-ink-700 px-4 py-2.5 text-sm font-medium transition flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-inset">
                  <i class="fa-solid fa-copy w-4 text-center" aria-hidden="true"></i> Copy Card
                </button>

                <%# data-turbo-frame="_top" breaks this form out of the
                    enclosing "modal" frame so the redirect performs a full
                    top-level visit — same escape hatch already used for the
                    Cancel link on cards/new.html.erb. Without it, Turbo
                    scopes the response to the "modal" frame and logs a
                    console warning when it can't find a matching (non-empty)
                    frame in the redirected board page. %>
                <%= button_to archive_card_path(@card),
                    method: :patch,
                    class: "w-full text-left bg-white hover:bg-warn-100 hover:text-warn-700 text-ink-700 px-4 py-2.5 text-sm font-medium transition flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-inset",
                    form: { data: { turbo_confirm: "Archive this card? You can restore it later.", turbo_frame: "_top" } } do %>
                  <i class="fa-solid fa-box-archive w-4 text-center" aria-hidden="true"></i> Archive Card
                <% end %>
              </div>

              <%# --- Copy-card form panel — hidden until "Copy card" is
                  clicked; anchored in the exact same popover, never shown
                  alongside the menu panel above. No data-turbo-frame here:
                  the turbo_stream response applies document-wide regardless
                  of which frame the request originated in, so the board
                  stays visible behind the modal after copying (see
                  CardsController#copy). %>
              <div data-card-actions-menu-target="form" class="hidden p-3 flex flex-col gap-3">
                <div class="flex items-center gap-2 border-b border-line pb-2">
                  <button type="button" data-action="click->card-actions-menu#showMenu"
                          aria-label="Back to card actions"
                          class="text-ink-500 hover:text-ink-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1 rounded">
                    <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
                  </button>
                  <div class="flex-1 text-center text-xs font-bold text-ink-500">Copy card</div>
                </div>

                <%= form_with url: copy_card_path(@card), method: :post, class: "space-y-3" do |f| %>
                  <div>
                    <%= f.label :title, "Title", class: "block text-xs font-medium text-ink-500 mb-1" %>
                    <%= f.text_field :title, value: @card.title,
                        class: "w-full text-sm border border-line rounded px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-700" %>
                  </div>

                  <div>
                    <%= f.label :list_id, "List", class: "block text-xs font-medium text-ink-500 mb-1" %>
                    <%= f.collection_select :list_id,
                        @card.list.board.lists.order(:position),
                        :id, :name,
                        { selected: @card.list_id },
                        { class: "w-full text-sm border border-line rounded px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-700" } %>
                  </div>

                  <%= f.submit "Copy card",
                      class: "w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-1.5 rounded text-sm cursor-pointer shadow-sm transition-colors" %>
                <% end %>
              </div>
            </div>
          </div>

          <%# CLOSE BUTTON %>
          <%= link_to close_path,
              class: "text-ink-500 hover:text-ink-700 transition flex items-center justify-center p-1 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1",
              "aria-label": "Close card",
              data: { turbo_action: "advance", modal_exit: true } do %>
            <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
          <% end %>
        </div>
      </div>

      <%# =========================================================== %>
      <%# MAIN GRID — left content + right conversation column. Stacks %>
      <%# to one column below the `lg` breakpoint (conversation below  %>
      <%# content — plain document order already puts it there).      %>
      <%# =========================================================== %>
      <div class="flex-1 grid grid-cols-1 lg:grid-cols-[1fr_400px] overflow-hidden">

        <%# --- LEFT COLUMN --- %>
        <div class="p-8 overflow-y-auto lg:border-r border-line">
          <div class="space-y-8">

            <%# 1. Title + complete-toggle (Trello position: left of the title) %>
            <div class="flex items-start gap-4">
              <%
                # Carries the modal's own return_to/sort forward through the
                # toggle's re-render (CardsController#toggle_complete calls
                # resolve_return_to! again from these same params) — without
                # this, toggling complete while viewing the modal over
                # /account/cards would silently lose that context and the
                # close button would fall back to the board on the next render.
                toggle_params = { from_modal: true, return_to: (@return_to_account ? "account" : nil), sort: @return_to_sort }
              %>
              <% if @card.completed? %>
                <%= button_to toggle_complete_card_path(@card),
                    method: :patch,
                    params: toggle_params,
                    form: { class: "m-0 shrink-0 mt-1" },
                    class: "h-6 w-6 rounded-full bg-success-600/90 hover:bg-success-600 border-2 border-success-600 flex items-center justify-center transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1#{" animate-complete-pop" if local_assigns.fetch(:just_completed, false)}",
                    title: "Mark incomplete",
                    aria: { label: "Mark incomplete" } do %>
                  <i class="fa-solid fa-check text-xs text-white" aria-hidden="true"></i>
                <% end %>
              <% else %>
                <%= button_to toggle_complete_card_path(@card),
                    method: :patch,
                    params: toggle_params,
                    form: { class: "m-0 shrink-0 mt-1" },
                    class: "h-6 w-6 rounded-full bg-white border-2 border-line hover:border-success-600 hover:bg-success-100 flex items-center justify-center transition-colors cursor-pointer group/complete focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1",
                    title: "Mark complete",
                    aria: { label: "Mark complete" } do %>
                  <i class="fa-solid fa-check text-xs text-transparent group-hover/complete:text-success-600" aria-hidden="true"></i>
                <% end %>
              <% end %>

              <div class="w-full">
                <h2 id="card_modal_title_<%= @card.id %>" class="font-display text-xl font-bold text-ink-700 leading-tight"><%= @card.title %></h2>
              </div>
            </div>

            <%# 2. Quick-add row — Checklist / Location / Attachment.       %>
            <%#    Relocated intact from the right column: same wrapper    %>
            <%#    divs, same Stimulus wiring, same forms — only popover   %>
            <%#    geometry changed (fixed width instead of stretching the %>
            <%#    old 400px column; Attachment anchors from the right so  %>
            <%#    its popover doesn't clip the modal's right edge, being  %>
            <%#    the rightmost button in the row).                      %>
            <div id="quick_add_row" class="ml-9 flex items-center gap-2 flex-wrap">

              <%# Checklist button %>
              <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                <button type="button" data-action="click->dropdown#toggle"
                        class="bg-surface-200 hover:bg-surface-300 text-ink-700 px-3 py-1.5 rounded text-sm font-medium transition flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1">
                  <i class="fa-solid fa-square-check w-4" aria-hidden="true"></i> Checklist
                </button>
                <div data-dropdown-target="menu"
                     class="hidden absolute left-0 top-full mt-2 w-72 bg-white border border-line rounded-lg shadow-xl z-30 p-3 flex flex-col gap-3">
                  <div class="text-center text-xs font-bold text-ink-500 border-b pb-2 mb-1">Add checklist</div>
                  <%= form_with model: [@card, Checklist.new], class: "space-y-3" do |f| %>
                    <div>
                      <%= f.label :title, "Title", class: "block text-xs font-bold text-ink-700 mb-1" %>
                      <%= f.text_field :title, value: "Checklist", class: "w-full text-sm border-line rounded focus:ring-brand-700 focus:border-brand-700" %>
                    </div>
                    <%= f.submit "Add", class: "w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-1.5 rounded text-sm cursor-pointer shadow-sm transition-colors" %>
                  <% end %>
                </div>
              </div>

              <%# Location button — Trello-style geocoded search. Selecting a
                  result PATCHes lat/lng/name/address to the card via the
                  Stimulus controller below. The static map preview appears
                  in the card body section once a location is set. %>
              <div class="relative"
                   data-controller="dropdown location-search"
                   data-action="click@window->dropdown#hide"
                   data-location-search-card-id-value="<%= @card.id %>"
                   data-location-search-card-url-value="<%= card_path(@card) %>">
                <button type="button" data-action="click->dropdown#toggle"
                        class="bg-surface-200 hover:bg-surface-300 text-ink-700 px-3 py-1.5 rounded text-sm font-medium transition flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1">
                  <i class="fa-solid fa-location-dot w-4" aria-hidden="true"></i> Location
                </button>
                <div data-dropdown-target="menu"
                     class="hidden absolute right-0 sm:right-auto sm:left-0 top-full mt-2 w-64 sm:w-80 bg-white border border-line rounded-lg shadow-xl z-30 p-3 flex flex-col gap-2">
                  <div class="text-center text-xs font-bold text-ink-500 border-b pb-2 mb-1">Search for a place</div>

                  <input type="text"
                         data-location-search-target="input"
                         data-action="input->location-search#search keydown->location-search#keydown"
                         placeholder="Type an address or place"
                         class="w-full px-3 py-2 bg-surface-50 focus:bg-white border border-line rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-700 focus:border-brand-700"
                         autocomplete="off">

                  <ul data-location-search-target="results"
                      class="max-h-64 overflow-y-auto divide-y divide-line text-sm hidden"></ul>

                  <p data-location-search-target="empty"
                     class="text-xs text-ink-300 text-center py-2 hidden">No places match.</p>

                  <% if @card.location? %>
                    <button type="button"
                            data-action="click->location-search#remove"
                            class="text-xs text-danger-600/80 hover:text-danger-600 underline mt-1">
                      Remove current location
                    </button>
                  <% end %>
                </div>
              </div>

              <%# Attachment button %>
              <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                <button type="button" data-action="click->dropdown#toggle"
                        class="bg-surface-200 hover:bg-surface-300 text-ink-700 px-3 py-1.5 rounded text-sm font-medium transition flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1">
                  <i class="fa-solid fa-paperclip w-4" aria-hidden="true"></i> Attachment
                </button>
                <div data-dropdown-target="menu"
                     class="hidden absolute left-0 sm:left-auto sm:right-0 top-full mt-2 w-64 sm:w-80 bg-white border border-line rounded-lg shadow-xl z-30 p-3 flex flex-col gap-3">
                  <div class="text-center text-xs font-bold text-ink-500 border-b pb-2 mb-1">Attach from computer</div>
                  <%= form_with model: @card, method: :patch, class: "space-y-3" do |f| %>
                    <div>
                      <%= f.file_field :attachments, multiple: true, class: "w-full text-sm text-ink-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-brand-100 file:text-brand-700 hover:file:bg-brand-100" %>
                    </div>
                    <%= f.submit "Attach", class: "w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-1.5 rounded text-sm cursor-pointer shadow-sm transition-colors" %>
                  <% end %>
                </div>
              </div>

            </div>

            <%# Inline alert slot — surfaces card-scoped errors (e.g. an
                attachment rejected by validation) right next to the
                action that triggered them (moved here with the quick-add
                row; the global flash partial ends up behind the modal
                because of z-index stacking). %>
            <% if flash.now[:alert].present? %>
              <div class="ml-9 bg-danger-50 border border-danger-600/25 text-danger-600 text-sm px-3 py-2 rounded flex items-start gap-2"
                   data-controller="flash"
                   data-flash-timeout-value="6000">
                <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
                <span><%= flash.now[:alert] %></span>
              </div>
            <% end %>

            <%# 3. Chips zone — Members, Labels, Due date (Trello order),
                grouped as one compact block under the quick-add row. %>
            <div class="ml-9 space-y-5">

              <%# Members %>
              <div>
                <h3 class="text-xs font-bold text-ink-500 uppercase mb-2">Members</h3>
                <div class="flex items-center gap-1">

                  <%# Avatars of currently assigned members %>
                  <div id="card_face_avatars_<%= @card.id %>" class="flex gap-1">
                    <%= render "cards/avatars", card: @card %>
                  </div>

                  <%# Member-picker dropdown %>
                  <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                    <button type="button" data-action="click->dropdown#toggle"
                            class="h-8 w-8 rounded-full bg-surface-200 hover:bg-surface-300 flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1"
                            title="Add members"
                            aria-label="Add members">
                      <i class="fa-solid fa-plus text-sm text-ink-500" aria-hidden="true"></i>
                    </button>

                    <div data-dropdown-target="menu"
                         class="hidden absolute top-10 left-0 w-72 bg-white border border-line rounded-lg shadow-xl z-30 p-3 flex flex-col gap-3">

                      <%# Members already on this card %>
                      <div>
                        <div class="text-[10px] font-bold text-ink-500 uppercase mb-2">Card members</div>
                        <div id="assigned_members_list" class="space-y-1">
                          <% @card.members.each do |user| %>
                            <%= render "cards/member_row", card: @card, user: user, assigned: true %>
                          <% end %>
                        </div>
                      </div>

                      <%# Board members (owner + invited) not yet on this card %>
                      <div>
                        <div class="text-[10px] font-bold text-ink-500 uppercase mb-2">Board members</div>
                        <div id="available_members_list" class="space-y-1 max-h-48 overflow-y-auto">
                          <% board = @card.list.board %>
                          <% (board.active_members - @card.members).each do |user| %>
                            <%= render "cards/member_row", card: @card, user: user, assigned: false %>
                          <% end %>
                        </div>
                      </div>

                    </div>
                  </div>

                </div>
              </div>

              <%# Labels %>
              <div>
                <h3 class="text-xs font-bold text-ink-500 uppercase mb-2">Labels</h3>
                <div class="flex items-center gap-1 flex-wrap">

                  <%# Existing label pills %>
                  <div id="card_labels_pills_<%= @card.id %>" class="flex flex-wrap gap-1">
                    <%= render "cards/label_pills", card: @card %>
                  </div>

                  <%# Picker dropdown %>
                  <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                    <button type="button" data-action="click->dropdown#toggle"
                            class="h-8 w-8 rounded-full bg-surface-200 hover:bg-surface-300 flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1"
                            title="Add labels"
                            aria-label="Add labels">
                      <i class="fa-solid fa-plus text-sm text-ink-500" aria-hidden="true"></i>
                    </button>

                    <div data-dropdown-target="menu"
                         class="hidden absolute top-10 left-0 w-72 bg-white border border-line rounded-lg shadow-xl z-30 p-3 flex flex-col gap-2">
                      <div class="text-[10px] font-bold text-ink-500 uppercase">Labels</div>

                      <div id="labels_list_<%= @card.list.board.id %>" class="space-y-1 max-h-64 overflow-y-auto">
                        <% @card.list.board.labels.order(:id).each do |label| %>
                          <%= render "cards/label_row", card: @card, label: label %>
                        <% end %>
                      </div>

                      <%# "Create new label" — Turbo frame swap to inline form %>
                      <%= turbo_frame_tag "new_label_row" do %>
                        <%= link_to new_board_label_path(@card.list.board, card_id: @card.id),
                            data: { turbo_frame: "new_label_row" },
                            class: "block w-full text-center text-sm bg-surface-200 hover:bg-surface-300 text-ink-700 py-1.5 rounded" do %>
                          <i class="fa-solid fa-plus text-xs mr-1"></i> Create a new label
                        <% end %>
                      <% end %>
                    </div>
                  </div>

                </div>
              </div>

              <%# Due date %>
              <div>
                <h3 class="text-xs font-bold text-ink-500 uppercase mb-2">Due date</h3>
                <div class="flex items-center gap-2">

                  <%# Existing pill (or "None" placeholder) %>
                  <%= render "cards/due_pill_frame", card: @card %>

                  <%# Picker dropdown %>
                  <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                    <button type="button" data-action="click->dropdown#toggle"
                            class="h-8 w-8 rounded-full bg-surface-200 hover:bg-surface-300 flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1"
                            title="Set due date"
                            aria-label="Set due date">
                      <i class="fa-solid fa-clock text-sm text-ink-500" aria-hidden="true"></i>
                    </button>

                    <div data-dropdown-target="menu"
                         class="hidden absolute top-10 left-0 w-72 bg-white border border-line rounded-lg shadow-xl z-30">
                      <%= render "cards/due_form", card: @card %>
                    </div>
                  </div>

                </div>
              </div>

            </div>

            <%# 4. Description %>
            <div class="ml-9">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-3">
                  <i class="fa-solid fa-align-left text-ink-500 text-lg"></i>
                  <h3 class="font-bold text-lg text-ink-700">Description</h3>
                </div>

                <%= link_to "Edit", edit_description_card_path(@card),
                    class: "bg-surface-200 hover:bg-surface-300 text-ink-700 text-sm font-medium px-3 py-1 rounded transition-colors",
                    data: { turbo_frame: dom_id(@card, :description) } %>
              </div>

              <%= render "cards/description", card: @card %>
            </div>

            <%# ============== %>
            <%# LOCATION       %>
            <%# ============== %>
            <% if @card.location? %>
              <div class="ml-9">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-location-dot text-ink-500 text-lg"></i>
                  <h3 class="font-bold text-lg text-ink-700">Location</h3>
                </div>

                <div class="bg-white border border-line rounded-lg overflow-hidden">
                  <%# Static map preview — Mapbox Static Images API. One HTTP
                      request, no JS, pin centered on the card's coords. %>
                  <% static_url = "https://api.mapbox.com/styles/v1/mapbox/streets-v12/static/" \
                                  "pin-l-marker+2563eb(#{@card.longitude},#{@card.latitude})/" \
                                  "#{@card.longitude},#{@card.latitude},14,0/" \
                                  "560x220@2x?access_token=#{mapbox_public_token}" %>
                  <img src="<%= static_url %>"
                       alt="Map showing <%= @card.location_name %>"
                       class="w-full h-44 object-cover">

                  <div class="p-3 flex items-start justify-between gap-2">
                    <div class="min-w-0">
                      <div class="text-sm font-semibold text-ink-700"><%= @card.location_name %></div>
                      <% if @card.location_address.present? && @card.location_address != @card.location_name %>
                        <div class="text-xs text-ink-500 mt-0.5"><%= @card.location_address %></div>
                      <% end %>
                    </div>

                    <%= button_to card_path(@card),
                        method: :patch,
                        params: { card: { latitude: "", longitude: "", location_name: "", location_address: "" } },
                        form: { class: "m-0 shrink-0", data: { turbo_confirm: "Remove this location?" } },
                        class: "h-6 w-6 rounded flex items-center justify-center text-ink-500 hover:text-danger-600 hover:bg-danger-50 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1",
                        title: "Remove location",
                        aria: { label: "Remove location" } do %>
                      <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <%# 5. Attachments %>
            <% if @card.attachments.attached? %>
              <div class="ml-9">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-paperclip text-ink-500 text-lg"></i>
                  <h3 class="font-bold text-lg text-ink-700">Attachments</h3>
                </div>
                <div class="space-y-3">
                  <% @card.attachments.each do |attachment| %>
                    <div id="<%= dom_id(attachment) %>" class="flex items-center gap-3 group">
                      <div class="h-20 w-28 bg-surface-200 rounded flex items-center justify-center overflow-hidden shrink-0">
                        <% if attachment.variable? %>
                          <%= image_tag attachment_thumb_url(attachment) %>
                        <% else %>
                          <i class="fa-solid fa-file text-2xl text-ink-300"></i>
                        <% end %>
                      </div>
                      <div class="flex flex-col">
                        <span class="text-sm font-bold text-ink-700"><%= attachment.filename %></span>
                        <div class="flex items-center gap-2 text-xs text-ink-500">
                          <span>Added <%= time_ago_in_words(attachment.created_at) %> ago</span>
                          <span>•</span>
                          <%= link_to "Download", rails_blob_path(attachment, disposition: "attachment"), class: "underline hover:text-ink-700" %>
                          <span>•</span>
                          <%= button_to card_attachment_path(@card, attachment),
                              method: :delete,
                              form: { class: "inline-block m-0", data: { turbo_confirm: "Delete this attachment?" } },
                              class: "text-xs text-danger-600/80 hover:text-danger-600 bg-transparent border-0 cursor-pointer underline p-0 m-0" do %>
                            Delete
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# 6. Checklists %>
            <div id="checklists_for_<%= @card.id %>">
              <% @card.checklists.each do |checklist| %>
                <%= render checklist %>
              <% end %>
            </div>

          </div>
        </div>

        <%# --- RIGHT COLUMN — pure conversation: header + comment form + feed --- %>
        <div id="conversation_column" class="bg-surface-50 p-6 overflow-y-auto flex flex-col h-full" data-controller="activity-toggle">

          <div class="flex items-center justify-between mb-4 shrink-0">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-list-ul text-ink-500"></i>
              <h3 class="font-bold text-base text-ink-700">Comments and activity</h3>
            </div>

            <button type="button"
                    data-activity-toggle-target="button"
                    data-action="click->activity-toggle#toggle"
                    class="text-xs font-medium text-ink-500 hover:text-ink-700 bg-surface-200 hover:bg-surface-300 px-3 py-1.5 rounded transition-colors">
              Hide details
            </button>
          </div>

          <%# Comment input %>
          <div class="mb-6 shrink-0">
            <%= render "comments/form", card: @card %>
          </div>

          <%# Feed (Comments + Activities) stream %>
          <div class="flex-1 overflow-y-auto pr-2 space-y-4 transition-all">
            <%= turbo_stream_from @card %>
            <div id="activities_and_comments" class="space-y-4">
              <%= render @feed %>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
<% end %>
