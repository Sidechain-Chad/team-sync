<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-[9999] flex items-center justify-center">

    <%# Overlay (clicking it closes the modal by navigating back to the board) %>
    <%= link_to board_path(@card.list.board),
        class: "absolute inset-0 bg-black/60 cursor-default",
        data: { turbo_action: "advance" } do %>
    <% end %>

    <%# THE MODAL BOX %>
    <div class="relative z-[10000] bg-[#f4f5f7] w-full max-w-6xl h-[90vh] rounded-lg shadow-2xl flex flex-col text-gray-700 m-4 pointer-events-auto"
         role="dialog"
         aria-modal="true"
         aria-labelledby="card_modal_title_<%= @card.id %>"
         tabindex="-1"
         data-modal-target="dialog">

      <%# =========================================================== %>
      <%# HEADER — current list name (click to open Move Card popover) %>
      <%# =========================================================== %>
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-300 bg-[#f4f5f7] rounded-t-lg shrink-0 z-20 relative">

        <%# MOVE CARD POPOVER %>
        <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">

          <%# Trigger: shows the current list name, clicking opens the Move popover %>
          <button type="button" data-action="click->dropdown#toggle"
                  class="flex items-center gap-2 bg-[#e9ebee] hover:bg-gray-300 px-3 py-1.5 rounded text-sm font-semibold text-gray-700 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1">
            <span><%= @card.list.name %></span>
            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
          </button>

          <%# Popover body %>
          <div data-dropdown-target="menu"
               class="hidden absolute top-full left-0 mt-2 w-72 bg-white border border-gray-300 rounded-lg shadow-xl z-[1001] flex flex-col text-left">

            <div class="p-2 border-b border-gray-200 flex items-center justify-center relative">
              <span class="text-xs font-bold text-gray-500">Move card</span>
              <button type="button" data-action="click->dropdown#toggle"
                      class="absolute right-2 top-2 text-gray-400 hover:text-gray-600 p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1 rounded"
                      aria-label="Close move card popover">
                <i class="fa-solid fa-xmark text-sm" aria-hidden="true"></i>
              </button>
            </div>

            <div class="p-3 bg-gray-50 rounded-b-lg">
              <div class="text-xs font-bold text-gray-500 mb-2 uppercase">Select destination</div>

              <%= form_with model: @card, method: :patch, class: "space-y-3" do |f| %>

                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">Board</label>
                  <div class="w-full p-2 bg-gray-200 border border-gray-300 rounded text-sm text-gray-600 cursor-not-allowed truncate">
                    <%= @card.list.board.name %>
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1">List</label>
                  <%= f.collection_select :list_id,
                      @card.list.board.lists.order(:position),
                      :id,
                      :name,
                      { selected: @card.list_id },
                      { class: "w-full p-2 bg-gray-50 focus:bg-white border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm" } %>
                </div>

                <%= f.submit "Move",
                    class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-1.5 rounded text-sm cursor-pointer mt-2 shadow-sm transition-colors" %>

              <% end %>
            </div>
          </div>
        </div>

        <%# CLOSE BUTTON %>
        <div class="flex items-center gap-3">
          <%= link_to board_path(@card.list.board),
              class: "text-gray-500 hover:text-gray-700 transition flex items-center justify-center p-1 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1",
              "aria-label": "Close card",
              data: { turbo_action: "advance" } do %>
            <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
          <% end %>
        </div>
      </div>

      <%# =========================================================== %>
      <%# MAIN GRID — left content + right sidebar                    %>
      <%# =========================================================== %>
      <div class="flex-1 grid grid-cols-[1fr_400px] overflow-hidden">

        <%# --- LEFT COLUMN --- %>
        <div class="p-8 overflow-y-auto border-r border-gray-200">
          <div class="space-y-8">

            <%# 1. Title %>
            <div class="flex items-start gap-4">
              <i class="fa-solid fa-window-maximize mt-1.5 text-gray-600 text-lg"></i>
              <div class="w-full">
                <h2 id="card_modal_title_<%= @card.id %>" class="text-xl font-bold text-gray-800 leading-tight"><%= @card.title %></h2>
              </div>
            </div>

            <%# 2. Members %>
            <div class="ml-9">
              <h3 class="text-xs font-bold text-gray-500 uppercase mb-2">Members</h3>
              <div class="flex items-center gap-1">

                <%# Avatars of currently assigned members %>
                <div id="card_face_avatars_<%= @card.id %>" class="flex gap-1">
                  <%= render "cards/avatars", card: @card %>
                </div>

                <%# Member-picker dropdown %>
                <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                  <button type="button" data-action="click->dropdown#toggle"
                          class="h-8 w-8 rounded-full bg-gray-200 hover:bg-gray-300 flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1"
                          title="Add members"
                          aria-label="Add members">
                    <i class="fa-solid fa-plus text-sm text-gray-600" aria-hidden="true"></i>
                  </button>

                  <div data-dropdown-target="menu"
                       class="hidden absolute top-10 left-0 w-72 bg-white border border-gray-200 rounded-lg shadow-xl z-30 p-3 flex flex-col gap-3">

                    <%# Members already on this card %>
                    <div>
                      <div class="text-[10px] font-bold text-gray-500 uppercase mb-2">Card members</div>
                      <div id="assigned_members_list" class="space-y-1">
                        <% @card.members.each do |user| %>
                          <%= render "cards/member_row", card: @card, user: user, assigned: true %>
                        <% end %>
                      </div>
                    </div>

                    <%# Board members (owner + invited) not yet on this card %>
                    <div>
                      <div class="text-[10px] font-bold text-gray-500 uppercase mb-2">Board members</div>
                      <div id="available_members_list" class="space-y-1 max-h-48 overflow-y-auto">
                        <% board = @card.list.board %>
                        <% (board.active_members - @card.members).each do |user| %>
                          <%= render "cards/member_row", card: @card, user: user, assigned: false %>
                        <% end %>
                      </div>
                    </div>

                  </div>
                </div>

              </div>
            </div>

            <%# Labels %>
            <div class="ml-9">
              <h3 class="text-xs font-bold text-gray-500 uppercase mb-2">Labels</h3>
              <div class="flex items-center gap-1 flex-wrap">

                <%# Existing label pills %>
                <div id="card_labels_pills_<%= @card.id %>" class="flex flex-wrap gap-1">
                  <%= render "cards/label_pills", card: @card %>
                </div>

                <%# Picker dropdown %>
                <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                  <button type="button" data-action="click->dropdown#toggle"
                          class="h-8 w-8 rounded-full bg-gray-200 hover:bg-gray-300 flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1"
                          title="Add labels"
                          aria-label="Add labels">
                    <i class="fa-solid fa-plus text-sm text-gray-600" aria-hidden="true"></i>
                  </button>

                  <div data-dropdown-target="menu"
                       class="hidden absolute top-10 left-0 w-72 bg-white border border-gray-200 rounded-lg shadow-xl z-30 p-3 flex flex-col gap-2">
                    <div class="text-[10px] font-bold text-gray-500 uppercase">Labels</div>

                    <div id="labels_list_<%= @card.list.board.id %>" class="space-y-1 max-h-64 overflow-y-auto">
                      <% @card.list.board.labels.order(:id).each do |label| %>
                        <%= render "cards/label_row", card: @card, label: label %>
                      <% end %>
                    </div>

                    <%# "Create new label" — Turbo frame swap to inline form %>
                    <%= turbo_frame_tag "new_label_row" do %>
                      <%= link_to new_board_label_path(@card.list.board, card_id: @card.id),
                          data: { turbo_frame: "new_label_row" },
                          class: "block w-full text-center text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 py-1.5 rounded" do %>
                        <i class="fa-solid fa-plus text-xs mr-1"></i> Create a new label
                      <% end %>
                    <% end %>
                  </div>
                </div>

              </div>
            </div>

            <%# Due date %>
            <div class="ml-9">
              <h3 class="text-xs font-bold text-gray-500 uppercase mb-2">Due date</h3>
              <div class="flex items-center gap-2">

                <%# Existing pill (or "None" placeholder) %>
                <%= render "cards/due_pill_frame", card: @card %>

                <%# Picker dropdown %>
                <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                  <button type="button" data-action="click->dropdown#toggle"
                          class="h-8 w-8 rounded-full bg-gray-200 hover:bg-gray-300 flex items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1"
                          title="Set due date"
                          aria-label="Set due date">
                    <i class="fa-solid fa-clock text-sm text-gray-600" aria-hidden="true"></i>
                  </button>

                  <div data-dropdown-target="menu"
                       class="hidden absolute top-10 left-0 w-72 bg-white border border-gray-200 rounded-lg shadow-xl z-30">
                    <%= render "cards/due_form", card: @card %>
                  </div>
                </div>

              </div>
            </div>

            <%# 3. Description %>
            <div class="ml-9">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-3">
                  <i class="fa-solid fa-align-left text-gray-600 text-lg"></i>
                  <h3 class="font-bold text-lg text-gray-800">Description</h3>
                </div>

                <%= link_to "Edit", edit_description_card_path(@card),
                    class: "bg-gray-200 hover:bg-gray-300 text-gray-700 text-sm font-medium px-3 py-1 rounded transition-colors",
                    data: { turbo_frame: dom_id(@card, :description) } %>
              </div>

              <%= render "cards/description", card: @card %>
            </div>

            <%# ============== %>
            <%# LOCATION       %>
            <%# ============== %>
            <% if @card.location? %>
              <div class="ml-9">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-location-dot text-gray-600 text-lg"></i>
                  <h3 class="font-bold text-lg text-gray-800">Location</h3>
                </div>

                <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
                  <%# Static map preview — Mapbox Static Images API. One HTTP
                      request, no JS, pin centered on the card's coords. %>
                  <% static_url = "https://api.mapbox.com/styles/v1/mapbox/streets-v12/static/" \
                                  "pin-l-marker+2563eb(#{@card.longitude},#{@card.latitude})/" \
                                  "#{@card.longitude},#{@card.latitude},14,0/" \
                                  "560x220@2x?access_token=#{mapbox_public_token}" %>
                  <img src="<%= static_url %>"
                       alt="Map showing <%= @card.location_name %>"
                       class="w-full h-44 object-cover">

                  <div class="p-3">
                    <div class="text-sm font-semibold text-gray-800"><%= @card.location_name %></div>
                    <% if @card.location_address.present? && @card.location_address != @card.location_name %>
                      <div class="text-xs text-gray-500 mt-0.5"><%= @card.location_address %></div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <%# 4. Attachments %>
            <% if @card.attachments.attached? %>
              <div class="ml-9">
                <div class="flex items-center gap-3 mb-3">
                  <i class="fa-solid fa-paperclip text-gray-600 text-lg"></i>
                  <h3 class="font-bold text-lg text-gray-800">Attachments</h3>
                </div>
                <div class="space-y-3">
                  <% @card.attachments.each do |attachment| %>
                    <div id="<%= dom_id(attachment) %>" class="flex items-center gap-3 group">
                      <div class="h-20 w-28 bg-gray-200 rounded flex items-center justify-center overflow-hidden shrink-0">
                        <% if attachment.variable? %>
                          <%= image_tag attachment.variant(resize_to_limit: [112, 80]) %>
                        <% else %>
                          <i class="fa-solid fa-file text-2xl text-gray-400"></i>
                        <% end %>
                      </div>
                      <div class="flex flex-col">
                        <span class="text-sm font-bold text-gray-700"><%= attachment.filename %></span>
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                          <span>Added <%= time_ago_in_words(attachment.created_at) %> ago</span>
                          <span>•</span>
                          <%= link_to "Download", rails_blob_path(attachment, disposition: "attachment"), class: "underline hover:text-gray-700" %>
                          <span>•</span>
                          <%= button_to card_attachment_path(@card, attachment),
                              method: :delete,
                              form: { class: "inline-block m-0", data: { turbo_confirm: "Delete this attachment?" } },
                              class: "text-xs text-red-600 hover:text-red-700 bg-transparent border-0 cursor-pointer underline p-0 m-0" do %>
                            Delete
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# 5. Checklists %>
            <div id="checklists_for_<%= @card.id %>">
              <% @card.checklists.each do |checklist| %>
                <%= render checklist %>
              <% end %>
            </div>

          </div>
        </div>

        <%# --- RIGHT COLUMN --- %>
        <div class="bg-gray-50 p-6 overflow-y-auto flex flex-col h-full" data-controller="activity-toggle">

          <%# Add to Card section %>
          <div class="mb-8 shrink-0">
            <h4 class="text-xs font-bold text-gray-500 uppercase mb-3">Add to card</h4>
            <div class="space-y-2">
              
              <%# Checklist button %>
              <div class="relative" data-controller="dropdown" data-action="click @window->dropdown#hide">
                <button type="button" data-action="click->dropdown#toggle"
                        class="w-full text-left bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-2 rounded text-sm font-medium transition flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1">
                  <i class="fa-solid fa-square-check w-4" aria-hidden="true"></i> Checklist
                </button>
                <div data-dropdown-target="menu"
                     class="hidden absolute top-10 left-0 right-0 bg-white border border-gray-200 rounded-lg shadow-xl z-50 p-3 flex flex-col gap-3">
                  <div class="text-center text-xs font-bold text-gray-500 border-b pb-2 mb-1">Add checklist</div>
                  <%= form_with model: [@card, Checklist.new], class: "space-y-3" do |f| %>
                    <div>
                      <%= f.label :title, "Title", class: "block text-xs font-bold text-gray-700 mb-1" %>
                      <%= f.text_field :title, value: "Checklist", class: "w-full text-sm border-gray-300 rounded focus:ring-blue-500 focus:border-blue-500" %>
                    </div>
                    <%= f.submit "Add", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-1.5 rounded text-sm cursor-pointer shadow-sm transition-colors" %>
                  <% end %>
                </div>
              </div>

              <%# Location button — Trello-style geocoded search. Selecting a
                  result PATCHes lat/lng/name/address to the card via the
                  Stimulus controller below. The static map preview appears
                  in the card body section once a location is set. %>
              <div class="relative"
                   data-controller="dropdown location-search"
                   data-action="click @window->dropdown#hide"
                   data-location-search-card-id-value="<%= @card.id %>"
                   data-location-search-card-url-value="<%= card_path(@card) %>">
                <button type="button" data-action="click->dropdown#toggle"
                        class="w-full text-left bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-2 rounded text-sm font-medium transition flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1">
                  <i class="fa-solid fa-location-dot w-4" aria-hidden="true"></i> Location
                </button>
                <div data-dropdown-target="menu"
                     class="hidden absolute top-10 left-0 right-0 bg-white border border-gray-200 rounded-lg shadow-xl z-50 p-3 flex flex-col gap-2">
                  <div class="text-center text-xs font-bold text-gray-500 border-b pb-2 mb-1">Search for a place</div>

                  <input type="text"
                         data-location-search-target="input"
                         data-action="input->location-search#search keydown->location-search#keydown"
                         placeholder="Type an address or place"
                         class="w-full px-3 py-2 bg-gray-50 focus:bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                         autocomplete="off">

                  <ul data-location-search-target="results"
                      class="max-h-64 overflow-y-auto divide-y divide-gray-100 text-sm hidden"></ul>

                  <p data-location-search-target="empty"
                     class="text-xs text-gray-400 text-center py-2 hidden">No places match.</p>

                  <% if @card.location? %>
                    <button type="button"
                            data-action="click->location-search#remove"
                            class="text-xs text-red-600 hover:text-red-800 underline mt-1">
                      Remove current location
                    </button>
                  <% end %>
                </div>
              </div>

              <%# Attachment button %>
              <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
                <button type="button" data-action="click->dropdown#toggle"
                        class="w-full text-left bg-gray-200 hover:bg-gray-300 text-gray-700 px-3 py-2 rounded text-sm font-medium transition flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1">
                  <i class="fa-solid fa-paperclip w-4" aria-hidden="true"></i> Attachment
                </button>
                <div data-dropdown-target="menu"
                     class="hidden absolute top-10 left-0 right-0 bg-white border border-gray-200 rounded-lg shadow-xl z-50 p-3 flex flex-col gap-3">
                  <div class="text-center text-xs font-bold text-gray-500 border-b pb-2 mb-1">Attach from computer</div>
                  <%= form_with model: @card, method: :patch, class: "space-y-3" do |f| %>
                    <div>
                      <%= f.file_field :attachments, multiple: true, class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
                    </div>
                    <%= f.submit "Attach", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-1.5 rounded text-sm cursor-pointer shadow-sm transition-colors" %>
                  <% end %>
                </div>
              </div>

            </div>

            <%# Inline alert slot — surfaces card-scoped errors (e.g. an
                attachment rejected by validation) right next to the
                action that triggered them. The global flash partial
                ends up behind the modal because of z-index stacking,
                so keep card alerts in here. %>
            <% if flash.now[:alert].present? %>
              <div class="mt-3 bg-red-50 border border-red-200 text-red-800 text-sm px-3 py-2 rounded flex items-start gap-2"
                   data-controller="flash"
                   data-flash-timeout-value="6000">
                <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
                <span><%= flash.now[:alert] %></span>
              </div>
            <% end %>
          </div>

          <div class="flex items-center justify-between mb-4 shrink-0">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-list-ul text-gray-600"></i>
              <h3 class="font-bold text-base text-gray-800">Activity</h3>
            </div>

            <button type="button"
                    data-activity-toggle-target="button"
                    data-action="click->activity-toggle#toggle"
                    class="text-xs font-medium text-gray-600 hover:text-gray-800 bg-gray-200 hover:bg-gray-300 px-3 py-1.5 rounded transition-colors">
              Hide details
            </button>
          </div>

          <%# Comment input %>
          <div class="mb-6 shrink-0">
            <%= render "comments/form", card: @card %>
          </div>

          <%# Feed (Comments + Activities) stream %>
          <div class="flex-1 overflow-y-auto pr-2 space-y-4 transition-all">
            <%= turbo_stream_from @card %>
            <div id="activities_and_comments" class="space-y-4">
              <%= render @feed %>
            </div>
          </div>

          <%# Move to list / Archive actions %>
          <div class="mt-6 pt-4 border-t border-gray-200 shrink-0">
            <h4 class="text-xs font-bold text-gray-500 uppercase mb-2">Actions</h4>

            <%# Keyboard-accessible alternative to dragging a card between
                lists — native selects, no custom dropdown JS. PATCHes the
                same cards#update endpoint the header's "Move card" popover
                uses, so list_id validation/activity logging/broadcast are
                all already handled there; this form just adds a position
                choice on top. %>
            <%= form_with model: @card, url: card_path(@card), method: :patch, class: "space-y-2 mb-3" do |f| %>
              <div>
                <%= f.label :list_id, "Move to list", class: "block text-xs font-medium text-gray-600 mb-1" %>
                <%= f.collection_select :list_id,
                    @card.list.board.lists.order(:position),
                    :id, :name,
                    { selected: @card.list_id },
                    { id: "card_move_list_id", class: "w-full text-sm border border-gray-300 rounded px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" } %>
              </div>

              <div>
                <%= label_tag "card_move_position", "Position", class: "block text-xs font-medium text-gray-600 mb-1" %>
                <%= select_tag "card[position]",
                    options_for_select([["Top", "top"], ["Bottom", "bottom"]], "bottom"),
                    id: "card_move_position",
                    class: "w-full text-sm border border-gray-300 rounded px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
              </div>

              <%= f.submit "Move",
                  class: "w-full bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-1.5 rounded text-sm cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1" %>
            <% end %>

            <%= button_to archive_card_path(@card),
                method: :patch,
                class: "w-full text-left bg-gray-200 hover:bg-yellow-100 hover:text-yellow-800 text-gray-700 px-3 py-2 rounded text-sm font-medium transition flex items-center gap-2 justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1",
                form: { data: { turbo_confirm: "Archive this card? You can restore it later." } } do %>
              <i class="fa-solid fa-box-archive w-4" aria-hidden="true"></i> Archive Card
            <% end %>
          </div>

        </div>

      </div>
    </div>
  </div>
<% end %>
