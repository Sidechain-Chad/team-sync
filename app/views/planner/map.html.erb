<div class="canvas-golden min-h-[calc(100vh-3.5rem)]">
  <div class="max-w-7xl mx-auto p-6 flex flex-col h-[calc(100vh-3.5rem)]">

  <%# ===== HEADER — mirrors planner/index.html.erb, including the narrow
      two-row stack (see that file for why flex-col and not flex-wrap). The
      "N cards with location" pill rides the title row: it describes the current
      view, not the navigation. %>
  <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between mb-6 shrink-0">
    <div class="flex items-center gap-3">
      <% if @last_board %>
        <%= link_to board_path(@last_board),
            class: "flex items-center gap-1.5 px-2.5 py-1.5 text-sm font-medium text-ink-500 hover:text-ink-900 hover:bg-surface-200 rounded transition",
            title: "Back to #{@last_board.name}" do %>
          <i class="fa-solid fa-chevron-left text-xs"></i>
          <span class="truncate max-w-[200px]"><%= @last_board.name %></span>
        <% end %>
      <% else %>
        <%= link_to boards_path,
            class: "flex items-center gap-1.5 px-2.5 py-1.5 text-sm font-medium text-ink-500 hover:text-ink-900 hover:bg-surface-200 rounded transition",
            title: "Back to boards" do %>
          <i class="fa-solid fa-chevron-left text-xs"></i>
          <span>Boards</span>
        <% end %>
      <% end %>
      <h1 class="font-display text-2xl font-bold text-ink-700"><%= @first_of_month.strftime("%B %Y") %></h1>
      <span class="text-xs text-ink-500 px-2 py-0.5 bg-surface-200 rounded-full">
        <%= pluralize(@located_cards.size, "card") %> with location
      </span>
    </div>

    <div class="flex items-center gap-2">
      <%# Calendar / Map toggle — same component as on the calendar view %>
      <div class="flex items-center bg-surface-200 rounded p-0.5 mr-2">
        <%= link_to planner_path(year: @year, month: @month),
            class: "px-3 py-1 text-xs font-medium rounded transition text-ink-500 hover:text-ink-900" do %>
          <i class="fa-regular fa-calendar text-[10px] mr-1"></i>Calendar
        <% end %>
        <%= link_to planner_map_path(year: @year, month: @month),
            class: "px-3 py-1 text-xs font-medium rounded transition bg-surface-0 text-ink-900 shadow-sm" do %>
          <i class="fa-solid fa-map-location-dot text-[10px] mr-1"></i>Map
        <% end %>
      </div>

      <%= link_to planner_map_path,
          class: "px-3 py-1.5 text-sm font-medium text-ink-700 bg-surface-0 border border-line rounded hover:bg-surface-50 transition" do %>
        Today
      <% end %>

      <div class="flex items-center">
        <%= link_to planner_map_path(year: @prev_month.year, month: @prev_month.month),
            class: "h-11 w-11 flex items-center justify-center text-ink-500 bg-surface-0 border border-line rounded-l hover:bg-surface-50 transition",
            title: "Previous month",
            aria: { label: "Previous month" } do %>
          <i class="fa-solid fa-chevron-left text-xs" aria-hidden="true"></i>
        <% end %>
        <%= link_to planner_map_path(year: @next_month.year, month: @next_month.month),
            class: "h-11 w-11 flex items-center justify-center text-ink-500 bg-surface-0 border border-l-0 border-line rounded-r hover:bg-surface-50 transition",
            title: "Next month",
            aria: { label: "Next month" } do %>
          <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
  </div>

  <%# ===== MAP ===== %>
  <% if @located_cards.empty? %>
    <div class="flex-1">
      <%= render "shared/map_empty_state" %>
    </div>
  <% else %>
    <div class="flex-1 relative bg-surface-0 rounded-lg shadow-sm border border-line overflow-hidden"
         data-controller="board-map">

      <div data-board-map-target="container" class="absolute inset-0"></div>

      <%# JSON payload — meta is "Board Name · Due Date" so popups make sense
          across boards. Same controller as the per-board map; the controller
          treats `meta` as a free-form pre-title line. %>
      <script type="application/json" data-board-map-target="data">
        <%= raw @located_cards.map { |c|
          {
            id:      c.id,
            title:   c.title,
            meta:    "#{c.list.board.name} · #{c.due_date.strftime('%a, %b %-d')}",
            address: c.location_address,
            lat:     c.latitude.to_f,
            lng:     c.longitude.to_f,
            url:     card_path(c)
          }
        }.to_json %>
      </script>
    </div>
  <% end %>

  </div>
</div>
