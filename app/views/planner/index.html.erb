<div class="max-w-7xl mx-auto p-6">

  <%# ===== HEADER ===== %>
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <%# Back link — prefers the user's most recently viewed board (set in
          BoardsController#show via session). Falls back to the boards index
          if there's no remembered board (first visit, or the remembered
          board was deleted/unshared). %>
      <% if @last_board %>
        <%= link_to board_path(@last_board),
            class: "flex items-center gap-1.5 px-2.5 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded transition",
            title: "Back to #{@last_board.name}" do %>
          <i class="fa-solid fa-chevron-left text-xs"></i>
          <span class="truncate max-w-[200px]"><%= @last_board.name %></span>
        <% end %>
      <% else %>
        <%= link_to boards_path,
            class: "flex items-center gap-1.5 px-2.5 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded transition",
            title: "Back to boards" do %>
          <i class="fa-solid fa-chevron-left text-xs"></i>
          <span>Boards</span>
        <% end %>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-800"><%= @first_of_month.strftime("%B %Y") %></h1>
    </div>

    <div class="flex items-center gap-2">
      <%# Calendar / Map toggle. Both views share month state via the
          year/month query params, so flipping between them keeps you
          on the same window. %>
      <div class="flex items-center bg-gray-100 rounded p-0.5 mr-2">
        <%= link_to planner_path(year: @year, month: @month),
            class: "px-3 py-1 text-xs font-medium rounded transition #{action_name == 'index' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:text-gray-900'}" do %>
          <i class="fa-regular fa-calendar text-[10px] mr-1"></i>Calendar
        <% end %>
        <%= link_to planner_map_path(year: @year, month: @month),
            class: "px-3 py-1 text-xs font-medium rounded transition #{action_name == 'map' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:text-gray-900'}" do %>
          <i class="fa-solid fa-map-location-dot text-[10px] mr-1"></i>Map
        <% end %>
      </div>

      <%= link_to planner_path,
          class: "px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 transition" do %>
        Today
      <% end %>

      <div class="flex items-center">
        <%= link_to planner_path(year: @prev_month.year, month: @prev_month.month),
            class: "px-2 py-1.5 text-gray-600 bg-white border border-gray-300 rounded-l hover:bg-gray-50 transition",
            title: "Previous month" do %>
          <i class="fa-solid fa-chevron-left text-xs"></i>
        <% end %>
        <%= link_to planner_path(year: @next_month.year, month: @next_month.month),
            class: "px-2 py-1.5 text-gray-600 bg-white border border-l-0 border-gray-300 rounded-r hover:bg-gray-50 transition",
            title: "Next month" do %>
          <i class="fa-solid fa-chevron-right text-xs"></i>
        <% end %>
      </div>
    </div>
  </div>

  <%# ===== CALENDAR GRID ===== %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">

    <%# Day-of-week header %>
    <div class="grid grid-cols-7 bg-gray-50 border-b border-gray-200">
      <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %>
        <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">
          <%= day %>
        </div>
      <% end %>
    </div>

    <%# Day cells. grid-rows-6 fixes the row count so cells stay equal-height. %>
    <div class="grid grid-cols-7 grid-rows-6">
      <% @days.each do |day| %>
        <%
          in_current_month = day.month == @month
          is_today         = day == Date.current
          cards_today      = @cards_by_day[day] || []
        %>
        <div class="min-h-[110px] border-r border-b border-gray-100 p-1.5 last:border-r-0
                    <%= 'bg-gray-50/50' unless in_current_month %>">

          <%# Date number — highlighted if today %>
          <div class="flex items-center justify-end mb-1">
            <span class="text-xs font-medium <%= 'h-5 w-5 rounded-full bg-blue-600 text-white flex items-center justify-center' if is_today %>
                          <%= 'text-gray-400' unless in_current_month %>
                          <%= 'text-gray-700' if in_current_month && !is_today %>">
              <%= day.day %>
            </span>
          </div>

          <%# Card chips for this day %>
          <div class="space-y-1">
            <% cards_today.each do |card| %>
              <%# Trello-style chip: just the title, single line, with a small colored
                  left stripe from the card's first label. Board name moved to the
                  title attribute so it still appears on hover for disambiguation. %>
              <%= link_to card_path(card),
                  data: { turbo_frame: "modal" },
                  class: "block text-[11px] leading-tight px-1.5 py-1 rounded truncate hover:opacity-80 transition-opacity cursor-pointer #{planner_chip_classes(card)}",
                  title: "#{card.title} — #{card.list.board.name}#{card.location? ? " · #{card.location_name}" : ''}" do %>
                <% if card.location? %>
                  <i class="fa-solid fa-location-dot text-[8px] mr-0.5 opacity-70"></i>
                <% end %><%= card.title %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

</div>
