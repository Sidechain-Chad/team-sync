<div class="canvas-golden min-h-[calc(100vh-3.5rem)]">
  <div class="max-w-7xl mx-auto p-6">

  <%# ===== HEADER =====
      Two rows on narrow, one row from sm: up.

      This was a single non-wrapping flex row, which pushed the nav cluster to
      x=392–515 at 375px — "Today" and both month arrows entirely off-screen and
      unreachable, with 140px of body overflow.

      Deliberately flex-col rather than flex-wrap: wrapping reflows by DOM order
      and content width, so it can strand "Today" on its own line with the arrows
      still on the first. The toggle, "Today" and the arrows are one control
      cluster and have to move as a unit. %>
  <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div class="flex items-center gap-3">
      <%# Back link — prefers the user's most recently viewed board (set in
          BoardsController#show via session). Falls back to the boards index
          if there's no remembered board (first visit, or the remembered
          board was deleted/unshared). %>
      <% if @last_board %>
        <%= link_to board_path(@last_board),
            class: "flex items-center gap-1.5 px-2.5 py-1.5 text-sm font-medium text-ink-500 hover:text-ink-900 hover:bg-surface-200 rounded transition",
            title: "Back to #{@last_board.name}" do %>
          <i class="fa-solid fa-chevron-left text-xs"></i>
          <span class="truncate max-w-[200px]"><%= @last_board.name %></span>
        <% end %>
      <% else %>
        <%= link_to boards_path,
            class: "flex items-center gap-1.5 px-2.5 py-1.5 text-sm font-medium text-ink-500 hover:text-ink-900 hover:bg-surface-200 rounded transition",
            title: "Back to boards" do %>
          <i class="fa-solid fa-chevron-left text-xs"></i>
          <span>Boards</span>
        <% end %>
      <% end %>
      <h1 class="font-display text-2xl font-bold text-ink-700"><%= @first_of_month.strftime("%B %Y") %></h1>
    </div>

    <div class="flex items-center gap-2">
      <%# Calendar / Map toggle. Both views share month state via the
          year/month query params, so flipping between them keeps you
          on the same window. %>
      <div class="flex items-center bg-surface-200 rounded p-0.5 mr-2">
        <%= link_to planner_path(year: @year, month: @month),
            class: "px-3 py-1 text-xs font-medium rounded transition #{action_name == 'index' ? 'bg-surface-0 text-ink-900 shadow-sm' : 'text-ink-500 hover:text-ink-900'}" do %>
          <i class="fa-regular fa-calendar text-[10px] mr-1"></i>Calendar
        <% end %>
        <%= link_to planner_map_path(year: @year, month: @month),
            class: "px-3 py-1 text-xs font-medium rounded transition #{action_name == 'map' ? 'bg-surface-0 text-ink-900 shadow-sm' : 'text-ink-500 hover:text-ink-900'}" do %>
          <i class="fa-solid fa-map-location-dot text-[10px] mr-1"></i>Map
        <% end %>
      </div>

      <%= link_to planner_path,
          class: "px-3 py-1.5 text-sm font-medium text-ink-700 bg-surface-0 border border-line rounded hover:bg-surface-50 transition" do %>
        Today
      <% end %>

      <div class="flex items-center">
        <%= link_to planner_path(year: @prev_month.year, month: @prev_month.month),
            class: "h-11 w-11 flex items-center justify-center text-ink-500 bg-surface-0 border border-line rounded-l hover:bg-surface-50 transition",
            title: "Previous month",
            aria: { label: "Previous month" } do %>
          <i class="fa-solid fa-chevron-left text-xs" aria-hidden="true"></i>
        <% end %>
        <%= link_to planner_path(year: @next_month.year, month: @next_month.month),
            class: "h-11 w-11 flex items-center justify-center text-ink-500 bg-surface-0 border border-l-0 border-line rounded-r hover:bg-surface-50 transition",
            title: "Next month",
            aria: { label: "Next month" } do %>
          <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>
  </div>

  <%# ===== CALENDAR GRID ===== %>
  <div class="bg-surface-0 rounded-lg shadow-sm border border-line overflow-hidden">

    <%# Day-of-week header %>
    <div class="grid grid-cols-7 bg-surface-50 border-b border-line">
      <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %>
        <div class="px-3 py-2 text-xs font-semibold text-ink-500 uppercase tracking-wide text-center">
          <%= day %>
        </div>
      <% end %>
    </div>

    <%# Day cells. grid-rows-6 fixes the row count so cells stay equal-height.
        Grid lines are drawn ONCE, via gap-px + a bg-line fill showing through
        the gaps, rather than per-cell border-r/border-b — the old approach
        put a border-r on every cell in a flat 42-cell list, and :last-child
        only matches cell #42 (bottom-right), so every Saturday in the other
        5 rows doubled up against the container's own right border. A shared
        gap has no "last cell" special case to get wrong. %>
    <div class="grid grid-cols-7 grid-rows-6 gap-px bg-line">
      <%# Lanes are assigned once per week ROW (not per cell) so a spanning
          card keeps the same vertical slot in every cell it crosses — see
          PlannerHelper#planner_week_lanes. Cells stay flat siblings of the
          grid container (no per-row wrapper div), which is what keeps the
          gap-px/bg-line grid lines and the 7-column auto-placement working. %>
      <% @days.each_slice(7) do |week| %>
        <% week_lanes = planner_week_lanes(week, @cards_by_day) %>
        <% week.each do |day| %>
          <%
            in_current_month = day.month == @month
            is_today         = day == Date.current
            cards_today      = @cards_by_day[day] || []
            lane_slots       = planner_lane_slots(day, cards_today, week_lanes)
            point_cards      = planner_point_cards(cards_today, week_lanes)
          %>
          <div class="min-h-[110px] p-1.5
                      <%= in_current_month ? 'bg-surface-0' : 'bg-surface-muted' %>"
               data-day="<%= day.iso8601 %>">

            <%# Date number — highlighted if today %>
            <div class="flex items-center justify-end mb-1">
              <span class="text-xs font-medium <%= 'h-5 w-5 rounded-full bg-brand-600 text-white flex items-center justify-center' if is_today %>
                            <%= 'text-ink-300' unless in_current_month %>
                            <%= 'text-ink-700' if in_current_month && !is_today %>">
                <%= day.day %>
              </span>
            </div>

            <%# Lane slots, then point chips. Lanes render FIRST and always
                reserve their row's full lane count (a blank placeholder where
                this day's lane is unoccupied), so point chips appended below
                can never displace a bar into a different slot than its
                neighbours. %>
            <div class="space-y-1">
              <% lane_slots.each_with_index do |card, lane_index| %>
                <% if card %>
                  <%# Trello-style chip: just the title, single line, with a small colored
                      left stripe from the card's first label. Board name moved to the
                      title attribute so it still appears on hover for disambiguation.

                      A card with BOTH a start and a due date renders one segment per
                      day it spans, squared off and bled across cell padding so the
                      row reads as a single bar. data-planner-lane is this row's
                      stable slot for this card — asserted directly in tests rather
                      than inferred from DOM position. %>
                  <% segment = planner_segment(card, day) %>
                  <% shows_title = planner_segment_shows_title?(card, day) %>
                  <%= link_to card_path(card),
                      data: { turbo_frame: "modal", planner_segment: segment, planner_lane: lane_index },
                      class: "block text-[11px] leading-tight px-1.5 py-1 truncate hover:opacity-80 transition-opacity cursor-pointer #{planner_chip_or_bar_classes(card, day)}",
                      title: "#{card.title} — #{card.list.board.name} · #{card.start_date.strftime('%b %-d')}–#{card.due_date.strftime('%b %-d')}#{card.location? ? " · #{card.location_name}" : ''}" do %>
                    <% if shows_title %>
                      <% if card.location? %>
                        <i class="fa-solid fa-location-dot text-[8px] mr-0.5 opacity-70"></i>
                      <% end %><%= card.title %>
                    <% else %>
                      <%# Continuation cell: the bar itself carries the meaning, and
                          the accessible name still comes from the title attribute. %>
                      <span class="invisible">&nbsp;</span>
                    <% end %>
                  <% end %>
                <% else %>
                  <%# This lane is occupied elsewhere in the row but not on this
                      day — an empty same-height placeholder so the lanes below
                      it stay aligned with the same lane in neighbouring cells. %>
                  <div class="text-[11px] leading-tight px-1.5 py-1" aria-hidden="true"><span class="invisible">&nbsp;</span></div>
                <% end %>
              <% end %>

              <% point_cards.each do |card| %>
                <%= link_to card_path(card),
                    data: { turbo_frame: "modal" },
                    class: "block text-[11px] leading-tight px-1.5 py-1 truncate hover:opacity-80 transition-opacity cursor-pointer #{planner_chip_or_bar_classes(card, day)}",
                    title: "#{card.title} — #{card.list.board.name}#{card.date_range? ? " · #{card.start_date.strftime('%b %-d')}–#{card.due_date.strftime('%b %-d')}" : ''}#{card.location? ? " · #{card.location_name}" : ''}" do %>
                  <% if card.location? %>
                    <i class="fa-solid fa-location-dot text-[8px] mr-0.5 opacity-70"></i>
                  <% end %><%= card.title %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  </div>
</div>
