<%# Per-board map view — full-bleed Mapbox map with a marker per card.
    Lives at /boards/:id/map.
    Empty state is rendered server-side so the
    page never appears blank, even if the JS controller fails to mount. %>

<div class="flex flex-col h-[calc(100vh-3.5rem)] bg-surface-50">

  <%# Header — light theme to match the app shell on this page. %>
  <div class="flex items-center justify-between px-6 py-3 border-b border-line bg-surface-0 shrink-0 shadow-sm z-content">
    <div class="flex items-center gap-3">
      <i class="fa-solid fa-location-dot text-brand-fg"></i>
      <h1 class="font-display text-ink-900 text-lg"><%= @board.name %></h1>
      <span class="text-ink-500 text-xs px-2.5 py-1 bg-surface-200 rounded-full border border-line">
        <%= pluralize( @located_cards.size, "card") %> on map
      </span>
    </div>
    <%= link_to board_path(@board),
        class: "flex items-center gap-2 px-3 py-1.5 rounded-md text-ink-500 hover:text-ink-900 hover:bg-surface-200 font-medium text-sm transition" do %>
      <i class="fa-solid fa-arrow-left text-xs"></i> Back to board
    <% end %>
  </div>

  <%# Body %>
  <div class="flex-1 relative overflow-hidden bg-surface-200">
    <% if @located_cards.empty? %>
      <div class="absolute inset-0 p-6">
        <%= render "shared/map_empty_state" %>
      </div>
    <% else %>
      <div class="absolute inset-0" data-controller="board-map">
        <div data-board-map-target="container" class="w-full h-full"></div>

        <%# JSON payload — meta is the list name %>
        <script type="application/json" data-board-map-target="data">
          <%= raw @located_cards.map { |c|
            {
              id:      c.id,
              title:   c.title,
              meta:    c.list.name,
              address: c.location_address,
              lat:     c.latitude.to_f,
              lng:     c.longitude.to_f,
              url:     card_path(c)
            }
          }.to_json %>
        </script>
      </div>
    <% end %>
  </div>
</div>
