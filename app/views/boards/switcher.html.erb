<%# Centered modal for switching between boards. Wrapped in the "modal"
    turbo-frame so it loads into the layout's modal mount point. The outer
    div is the dimmed backdrop; clicking it closes via the modal Stimulus
    controller already attached to the frame in application.html.erb. %>
<%= turbo_frame_tag "modal" do %>
  <%# Backdrop click closes the modal. The inner panel uses stop_propagation_controller.js
      so clicks inside don't bubble up and trigger the close. %>
  <div class="fixed inset-0 bg-scrim/40 z-modal flex items-start justify-center pt-20"
       data-action="click->modal#close">
    <div class="bg-surface-0 rounded-lg shadow-2xl w-full max-w-2xl mx-4 max-h-[80vh] overflow-hidden flex flex-col"
         data-controller="stop-propagation"
         data-action="click->stop-propagation#stop">

      <%# Header %>
      <div class="flex items-center justify-between px-5 py-4 border-b border-line">
        <h2 class="text-lg font-bold text-ink-700">Switch boards</h2>
        <%= link_to "#", data: { action: "click->modal#close" },
            class: "text-ink-300 hover:text-ink-500 text-xl leading-none" do %>
          &times;
        <% end %>
      </div>

      <%# Body %>
      <div class="overflow-y-auto p-5">

        <% if @owned_boards.any? %>
          <div class="mb-6">
            <h3 class="text-xs font-bold text-ink-500 uppercase tracking-wide mb-3">Your boards</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <% @owned_boards.each do |board| %>
                <%= link_to board_path(board),
                    class: "block group rounded-md overflow-hidden border border-line hover:border-ink-300 hover:shadow-md transition",
                    data: { turbo: false } do %>
                  <div class="group-hover:opacity-90 transition">
                    <%= render "boards/cover", board: board, height_class: "h-24" %>
                  </div>
                  <div class="p-2.5">
                    <p class="text-sm font-medium text-ink-700 truncate"><%= board.name %></p>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @shared_boards.any? %>
          <div>
            <h3 class="text-xs font-bold text-ink-500 uppercase tracking-wide mb-3">Shared with you</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <% @shared_boards.each do |board| %>
                <%= link_to board_path(board),
                    class: "block group rounded-md overflow-hidden border border-line hover:border-ink-300 hover:shadow-md transition",
                    data: { turbo: false } do %>
                  <div class="group-hover:opacity-90 transition">
                    <%= render "boards/cover", board: board, height_class: "h-24" %>
                  </div>
                  <div class="p-2.5">
                    <p class="text-sm font-medium text-ink-700 truncate"><%= board.name %></p>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @owned_boards.empty? && @shared_boards.empty? %>
          <div class="text-center text-ink-500 py-8">
            No boards yet. <%= link_to "Create your first board", new_board_path, class: "text-brand-fg hover:text-brand-fg-hover font-medium", data: { turbo: false } %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
<% end %>
