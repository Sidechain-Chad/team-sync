<%# Trello-style tile: cover banner (avatar or a deterministic gradient)
    + compact footer with name/updated-at. Star and gear float above the
    cover as siblings of the link — not nested inside it — so clicking
    either never triggers navigation into the board. %>
<div class="group relative bg-white rounded-lg shadow-sm hover:shadow-lg border border-line overflow-hidden transition-all duration-150 hover:-translate-y-0.5">

  <%= link_to board_path(board), class: "block" do %>
    <%= render "boards/cover", board: board, height_class: "h-24" %>

    <div class="px-3 py-2.5">
      <h3 class="font-display text-sm font-semibold text-ink-700 truncate"><%= board.name %></h3>
      <p class="text-xs text-ink-500 mt-0.5">Updated <%= time_ago_in_words(board.updated_at) %> ago</p>
    </div>
  <% end %>

  <%# Already-starred boards keep their star visible; others fade in on
      hover — or on keyboard focus, so the button is reachable via Tab. %>
  <div class="absolute top-2 right-2 transition-opacity [&_i]:drop-shadow-md <%= board.favorited_by?(current_user) ? "opacity-100" : "opacity-0 group-hover:opacity-100 group-focus-within:opacity-100" %>">
    <%= render "boards/star_button", board: board %>
  </div>

  <% if board.user == current_user %>
    <%= link_to edit_board_path(board),
        class: "absolute top-2 left-2 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity h-8 w-8 rounded-full bg-ink-900/30 hover:bg-ink-900/50 backdrop-blur-sm text-white flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1",
        title: "Edit #{board.name}",
        "aria-label": "Edit #{board.name}" do %>
      <i class="fa-solid fa-gear text-xs" aria-hidden="true"></i>
    <% end %>
  <% end %>

</div>
