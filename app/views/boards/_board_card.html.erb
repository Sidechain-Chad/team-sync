<%# Trello-style tile: cover banner (avatar or a deterministic gradient)
    + compact footer with name/updated-at. Star and gear float above the
    cover as siblings of the link — not nested inside it — so clicking
    either never triggers navigation into the board. %>
<div class="group relative bg-surface-0 rounded-lg shadow-sm hover:shadow-lg border border-line overflow-hidden transition-all duration-300 ease-out hover:-translate-y-0.5">

  <%= link_to board_path(board), class: "block" do %>
    <%= render "boards/cover", board: board, height_class: "h-24" %>

    <div class="px-3 py-2.5">
      <h3 class="font-display text-sm font-semibold text-ink-700 truncate"><%= board.name %></h3>
      <p class="text-xs text-ink-500 mt-0.5">Updated <%= time_ago_in_words(board.updated_at) %> ago</p>
    </div>
  <% end %>

  <%# Watch eye + star, top-right corner. The eye is a plain server-rendered
      indicator (not a toggle — watching is toggled from the board's own
      title menu), always visible while watching: unlike the star's own
      fade-in wrapper below, its opacity must NOT be keyed off favorited_by?,
      or a watched-but-unfavorited board would hide it until hover. Safe to
      render per-user here, unlike a card tile: the boards index isn't a
      Turbo Stream broadcast target, so there's no shared-HTML-shows-one-
      user's-state problem (see boards/_star_button's own precedent). %>
  <div class="absolute top-2 right-2 flex items-center gap-1 [&_i]:drop-shadow-md">
    <% if board.watched_by?(current_user) %>
      <span class="h-8 w-8 flex items-center justify-center text-white" title="You're watching this board" aria-label="You're watching this board">
        <i class="fa-solid fa-eye text-xs" aria-hidden="true"></i>
      </span>
    <% end %>

    <%# Already-starred boards keep their star visible; others fade in on
        hover — or on keyboard focus, so the button is reachable via Tab. %>
    <div class="transition-opacity duration-300 ease-out <%= board.favorited_by?(current_user) ? "opacity-100" : "opacity-0 group-hover:opacity-100 group-focus-within:opacity-100" %>">
      <%= render "boards/star_button", board: board %>
    </div>
  </div>

  <% if board.user == current_user %>
    <%= link_to edit_board_path(board),
        class: "absolute top-2 left-2 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 ease-out h-8 w-8 rounded-full bg-scrim/30 hover:bg-scrim/50 backdrop-blur-sm text-white flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1",
        title: "Edit #{board.name}",
        "aria-label": "Edit #{board.name}" do %>
      <i class="fa-solid fa-gear text-xs" aria-hidden="true"></i>
    <% end %>
  <% end %>

</div>
