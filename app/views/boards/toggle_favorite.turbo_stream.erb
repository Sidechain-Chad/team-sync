<%# Re-render every instance of this board's star button so the
    filled/outlined state flips without a full page reload — the boards
    index can show the same board's star twice (Starred + home section). %>
<%= turbo_stream.replace_all ".board-star-#{@board.id}" do %>
  <%= render "boards/star_button", board: @board %>
<% end %>

<%# Replace target only exists on the boards index; Turbo silently no-ops
    this stream when toggling from a board's own header (board#show). %>
<%= turbo_stream.replace "starred_section" do %>
  <%= render "boards/starred_section", starred_boards: @starred_boards %>
<% end %>

<%# Sidebar Starred mini-list — same no-op-off-index behavior as above. %>
<%= turbo_stream.replace "starred_sidebar_list" do %>
  <%= render "boards/starred_sidebar_list", starred_boards: @starred_boards %>
<% end %>
