<%# Board activity feed — a plain page, deliberately not a drawer and not the
    "modal" turbo-frame (that frame's targeting is load-bearing and fragile).
    A page is linkable, testable, and needs no new JS. %>
<div class="canvas-golden min-h-[calc(100vh-3.5rem)]">
  <div class="w-full max-w-4xl mx-auto p-6">

    <%# Header — same shape as the archive page %>
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-line">
      <div>
        <%= link_to board_path(@board),
            class: "text-sm text-ink-500 hover:text-brand-600 flex items-center gap-1 mb-2" do %>
          <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
          Back to <%= @board.name %>
        <% end %>
        <h1 class="font-display text-2xl font-bold text-ink-700 flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-ink-500" aria-hidden="true"></i>
          Activity
        </h1>
      </div>
    </div>

    <% if @feed.empty? %>
      <div class="bg-white rounded-lg shadow-sm border border-line text-center py-12">
        <i class="fa-solid fa-clock-rotate-left text-5xl text-ink-300 mb-4" aria-hidden="true"></i>
        <p class="text-ink-500">No activity yet.</p>
        <p class="text-sm text-ink-300 mt-1">Actions taken on this board's cards will show up here.</p>
      </div>
    <% else %>
      <%# Mixed feed of Activity and Comment rows (merged in BoardsController
          #activity), each with its own board-flavoured partial. The id is the
          append target for each "Load more" page — see activity.turbo_stream.erb. %>
      <div id="activity_feed_rows" class="bg-white rounded-lg shadow-sm border border-line divide-y divide-line">
        <%= render "boards/activity_rows", feed: @feed %>
      </div>

      <%# Replaced (not appended) on each page, so it updates itself and
          disappears once the history runs out. %>
      <%= render "boards/activity_load_more", board: @board, has_more: @has_more, next_page: @next_page %>
    <% end %>

  </div>
</div>
