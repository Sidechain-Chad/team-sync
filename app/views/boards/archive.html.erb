<div class="canvas-golden min-h-[calc(100vh-3.5rem)]">
  <div class="w-full max-w-4xl mx-auto p-6">

    <%# Header %>
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-line">
      <div>
        <%= link_to board_path(@board),
            class: "text-sm text-ink-500 hover:text-brand-fg flex items-center gap-1 mb-2" do %>
          <i class="fa-solid fa-arrow-left text-xs"></i>
          Back to <%= @board.name %>
        <% end %>
        <h1 class="font-display text-2xl font-bold text-ink-700 flex items-center gap-2">
          <i class="fa-solid fa-box-archive text-ink-500"></i>
          Archived Items
        </h1>
      </div>
    </div>

    <%# Empty state. border-2 (not the plain 1px border every other panel in
        this app uses), same --color-line token — see the block comment
        below the populated branch for why: at the flat nav-matching dark
        background, a single hairline border is nearly invisible, and an
        otherwise-empty panel like this one has nothing else (no card rows)
        to signal "there's a container here" instead. %>
    <% if @archived_cards.empty? %>
      <div class="bg-surface-0 rounded-lg shadow-sm border-2 border-line text-center py-12">
        <i class="fa-solid fa-box-archive text-5xl text-ink-300 mb-4"></i>
        <p class="text-ink-500">Nothing has been archived yet.</p>
        <p class="text-sm text-ink-300 mt-1">Archived cards will appear here.</p>
      </div>
    <% else %>

      <%# Same border-2 border-line strengthening as the empty state above —
          kept consistent between both branches rather than only fixing the
          one the screenshot happened to show. border-2 is an established
          pattern in this app for a panel that needs to read as more
          prominent than the plain 1px border (see the checkbox circles in
          cards/_card.html.erb and account/_card_row.html.erb, and the
          "create new board" dashed tile on boards/index.html.erb) — same
          --color-line token, just doubled in width, not a new token and
          not a token value change. %>
      <div class="bg-surface-0 rounded-lg shadow-sm border-2 border-line p-4">
        <div class="text-xs text-ink-500 uppercase font-bold mb-3">
          Cards (<%= @archived_cards.size %>)
        </div>

        <div class="space-y-2">
          <% @archived_cards.each do |card| %>
            <div class="flex items-center gap-3 p-3 bg-surface-50 hover:bg-surface-200 border border-line rounded-md transition-colors">

              <%# Card preview %>
              <div class="flex-1 min-w-0">
                <%# Label pills + title %>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <% card.labels.each do |label| %>
                    <span class="inline-flex items-center text-[10px] font-semibold px-1.5 py-0.5 rounded <%= label_solid_class(label.color) %>">
                      <%= label.name.presence || label.color.capitalize %>
                    </span>
                  <% end %>
                  <span class="font-medium text-ink-700 text-sm truncate"><%= card.title %></span>
                </div>

                <%# Context — which list it came from + when archived %>
                <div class="text-xs text-ink-500 flex items-center gap-2">
                  <span>From list <strong><%= card.list.name %></strong></span>
                  <span>·</span>
                  <span>Archived <%= time_ago_in_words(card.archived_at) %> ago</span>
                  <% if card.members.any? %>
                    <span>·</span>
                    <span><%= pluralize(card.members.size, "member") %></span>
                  <% end %>
                </div>
              </div>

              <%# Actions %>
              <div class="flex items-center gap-2 shrink-0">
                <%= button_to unarchive_card_path(card),
                    method: :patch,
                    form: { class: "m-0" },
                    class: "text-sm bg-brand-600 hover:bg-brand-700 text-white px-3 py-1.5 rounded transition-colors flex items-center gap-1" do %>
                  <i class="fa-solid fa-rotate-left text-xs"></i>
                  Restore
                <% end %>

                <%= button_to card_path(card),
                    method: :delete,
                    form: { class: "m-0", data: { turbo_confirm: "Permanently delete this card? This cannot be undone." } },
                    class: "text-sm bg-surface-200 hover:bg-danger-50 hover:text-danger-fg text-ink-700 px-3 py-1.5 rounded transition-colors flex items-center gap-1" do %>
                  <i class="fa-solid fa-trash text-xs"></i>
                  Delete
                <% end %>
              </div>

            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>
