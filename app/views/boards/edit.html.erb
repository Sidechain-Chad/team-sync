<div class="max-w-md mx-auto py-10 px-4">
  <div class="bg-white p-6 rounded-lg shadow-sm border border-line">

    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-bold text-ink-700">Board Settings</h2>
      <%= link_to "Cancel", root_path, class: "text-sm text-ink-500 hover:text-ink-700" %>
    </div>

    <%= form_with(model: @board, class: "space-y-4") do |f| %>

      <div>
        <%= f.label :name, class: "block text-sm font-medium text-ink-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border-line rounded-md shadow-sm focus:border-brand-700 focus:ring-brand-700" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-ink-700 mb-1">Board Logo / Avatar</label>
        <div class="flex items-center space-x-4">
          <% if @board.avatar.attached? %>
             <%= image_tag @board.avatar, class: "h-16 w-16 rounded object-cover border" %>
          <% end %>
          <%= f.file_field :avatar, class: "block w-full text-sm text-ink-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-100 file:text-brand-700 hover:file:bg-brand-100" %>
        </div>
      </div>

      <div class="pt-4 border-t border-line flex justify-between items-center mt-6">
        <% if @board.owner?(current_user) %>
          <%= link_to "Delete Board", board_path(@board), data: { turbo_method: :delete, turbo_confirm: "Delete this entire board and all cards?" }, class: "text-danger-600/80 text-sm hover:text-danger-600" %>
        <% else %>
          <span></span>
        <% end %>

        <%= f.submit "Save Changes", class: "bg-brand-600 text-white px-4 py-2 rounded-md hover:bg-brand-700 cursor-pointer" %>
      </div>

    <% end %>
  </div>

  <hr class="my-8 border-line">

  <div>
    <h3 class="text-lg font-bold text-ink-700 mb-4">Team Members</h3>

    <% if @board.owner?(current_user) %>
      <div class="bg-surface-50 p-4 rounded-lg mb-6">
        <%= form_with url: board_board_users_path(@board), method: :post, class: "flex gap-2" do |f| %>
          <%= f.email_field :email, placeholder: "teammate@example.com", class: "flex-1 border-line rounded-md shadow-sm focus:border-brand-700 focus:ring-brand-700", required: true %>
          <%= f.submit "Invite", class: "bg-brand-600 text-white px-4 py-2 rounded-md hover:bg-brand-700 cursor-pointer" %>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-3">
      <% @board.board_users.includes(user: { avatar_attachment: :blob }).each do |membership| %>
        <% member = membership.user %>

        <div class="flex justify-between items-center bg-white p-3 border rounded shadow-sm">
          <div class="flex items-center space-x-3">

            <%= render "shared/avatar", user: member, size: "h-10 w-10", text_size: "text-sm",
                css_class: "shrink-0 border-2 border-white shadow-sm ring-2 ring-surface-200",
                fallback_class: "bg-brand-600 text-white" %>

            <div class="flex flex-col">
              <span class="text-sm font-bold text-ink-900 leading-none"><%= member.display_name %></span>
              <span class="text-xs text-ink-500 mt-1"><%= member.email %></span>
            </div>
          </div>

          <% if member != current_user %>
            <% if @board.owner?(current_user) %>
              <%= button_to "Remove", board_board_user_path(@board, membership), method: :delete, class: "text-danger-600/80 text-xs hover:text-danger-600 border border-danger-600/25 hover:bg-danger-50 px-3 py-1 rounded transition" %>
            <% end %>
          <% else %>
             <span class="text-xs text-ink-300 italic px-3 py-1">Owner</span>
          <% end %>
        </div>
      <% end %>

      <% if @board.board_users.empty? %>
        <p class="text-sm text-ink-500 italic">No members yet.</p>
      <% end %>
    </div>
  </div>

</div>
