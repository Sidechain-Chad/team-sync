<%= turbo_stream_from @board %>

<%# Canvas wallpaper — an uploaded board background photo (scrimmed dark so
    the white title/action cluster stays legible over it), or else the same
    deterministic warm gradient as this board's tile cover, so the board
    recognizably matches its index-page tile. Persimmon is rationed to
    actions elsewhere; this is background wallpaper behind opaque white
    list panels, same visual role the original flat blue-600 canvas played.
    background-attachment: fixed keeps the wallpaper still while the board
    scrolls horizontally (iOS Safari degrades this to `scroll`, which still
    looks fine). %>
<% bg_url = board_background_url(@board) %>
<div class="board-canvas h-[calc(100vh-3.5rem)] <%= "bg-gradient-to-br #{board_cover_gradient_classes(@board)}" unless bg_url %> overflow-x-auto flex flex-col"
     <% if bg_url %>style="background-image: linear-gradient(rgba(0,0,0,.28), rgba(0,0,0,.28)), url('<%= bg_url %>'); background-size: cover; background-position: center; background-attachment: fixed;"<% end %>
     data-controller="board-filter keyboard"
     data-action="shortcuts:open@window->keyboard#openHelp">

  <%# ===== BOARD HEADER ===== Trello-style title + action cluster.
      Title on the left (with dropdown), actions and members on the right. %>
  <div class="flex-shrink-0 px-4 pt-4 pb-3 flex items-center justify-between gap-4">

    <%# ===== LEFT: title + dropdown ===== %>
    <div class="relative inline-block"
         data-controller="dropdown"
         data-action="click@document->dropdown#hide">

      <button type="button"
              data-action="click->dropdown#toggle"
              class="group flex items-center gap-2 text-white font-bold text-lg px-2 py-1 rounded-md hover:bg-white/15 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1">
        <span class="font-display"><%= @board.name %></span>
        <i class="fa-solid fa-chevron-down text-[10px] opacity-80 group-hover:opacity-100" aria-hidden="true"></i>
      </button>

      <%# Menu — hidden until toggle. Pinned to the button's lower-left edge. %>
      <div data-dropdown-target="menu"
           class="hidden absolute left-0 top-full mt-2 w-72 bg-white rounded-lg shadow-2xl ring-1 ring-ink-900/5 z-menu overflow-hidden">

        <div class="px-4 py-3 border-b border-line">
          <h3 class="text-sm font-semibold text-ink-700">Board menu</h3>
        </div>

        <div class="py-1">
          <%# Edit board name + cover %>
          <%= link_to edit_board_path(@board),
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors" do %>
            <i class="fa-solid fa-pen-to-square text-ink-500 w-4 text-center" aria-hidden="true"></i>
            <span>Edit board details</span>
          <% end %>

          <%# Members — same edit page, just scrolled to the members section %>
          <%= link_to edit_board_path(@board, anchor: "members"),
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors" do %>
            <i class="fa-solid fa-user-group text-ink-500 w-4 text-center" aria-hidden="true"></i>
            <span>Members</span>
          <% end %>

          <%# Activity — board-wide feed of every card event on this board %>
          <%= link_to activity_board_path(@board),
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors" do %>
            <i class="fa-solid fa-clock-rotate-left text-ink-500 w-4 text-center" aria-hidden="true"></i>
            <span>Activity</span>
          <% end %>

          <%# Archived items — re-uses the existing archive page %>
          <%= link_to archive_board_path(@board),
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors" do %>
            <i class="fa-solid fa-box-archive text-ink-500 w-4 text-center" aria-hidden="true"></i>
            <span>Archived items</span>
          <% end %>
        </div>

        <%# Close board — reversible, so it sits with the ordinary actions and
            is styled like them, NOT with Delete below. Owner-only, matching
            boards#close's set_owned_board guard. The confirm copy leads with
            reversibility so it can't be mistaken for the delete beneath it. %>
        <% if @board.owner?(current_user) && !@board.closed? %>
          <div class="py-1 border-t border-line">
            <%= link_to close_board_path(@board),
                data: { turbo_method: :patch, turbo_confirm: "Close this board? It's hidden from your boards, search and planner, but nothing is deleted — you can reopen it any time." },
                class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors" do %>
              <i class="fa-solid fa-box-archive text-ink-500 w-4 text-center" aria-hidden="true"></i>
              <span>Close board</span>
            <% end %>
          </div>
        <% end %>

        <%# Destructive action separated by a divider, styled red.
            Owner-only — matches boards#destroy's enforcement. Unchanged, and
            deliberately independent of closing: neither gates the other. %>
        <% if @board.owner?(current_user) %>
          <div class="py-1 border-t border-line">
            <%= link_to board_path(@board),
                data: { turbo_method: :delete, turbo_confirm: "Delete this entire board and all cards? This cannot be undone." },
                class: "flex items-center gap-3 px-4 py-2.5 text-sm text-danger-600 hover:bg-danger-50 transition-colors" do %>
              <i class="fa-solid fa-trash w-4 text-center" aria-hidden="true"></i>
              <span>Delete board</span>
            <% end %>
          </div>
        <% end %>

      </div>
    </div>

    <%# ===== RIGHT: header action cluster ===== %>
    <div class="flex items-center gap-1">

      <%# Filter — real, client-side (board_filter_controller.js) %>
      <%= render "boards/filter_popover", board: @board %>

      <%# Automation / lightning — placeholder %>
      <button type="button"
              class="h-8 w-8 flex items-center justify-center rounded hover:bg-white/20 transition-colors text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1"
              title="Automation (coming soon)"
              aria-label="Automation (coming soon)">
        <i class="fa-solid fa-bolt text-sm" aria-hidden="true"></i>
      </button>

      <%# Power-Ups / plug — placeholder %>
      <button type="button"
              class="h-8 w-8 flex items-center justify-center rounded hover:bg-white/20 transition-colors text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1"
              title="Power-Ups (coming soon)"
              aria-label="Power-Ups (coming soon)">
        <i class="fa-solid fa-plug text-sm" aria-hidden="true"></i>
      </button>

      <%# Star — real, toggles favorite state %>
      <%= render "boards/star_button", board: @board %>

      <%# Members — real avatars from board.members. Owner first, then
          shared members. Capped at 3 visible plus a +N indicator. %>
      <div class="flex items-center -space-x-1.5 ml-2">
        <% members = ([@board.user] + @board.members.to_a).uniq %>
        <% members.first(3).each do |user| %>
          <%= render "shared/avatar", user: user, size: "h-7 w-7", text_size: "text-[10px]", css_class: "ring-2 ring-white/30", title: user.display_name %>
        <% end %>
        <% if members.size > 3 %>
          <div class="h-7 w-7 rounded-full bg-white/20 text-white flex items-center justify-center text-[10px] font-bold ring-2 ring-white/30"
               title="<%= members.size - 3 %> more members">
            +<%= members.size - 3 %>
          </div>
        <% end %>
      </div>

      <%# Share — routes to the existing members section on edit page %>
      <%= link_to edit_board_path(@board, anchor: "members"),
          class: "ml-2 flex items-center gap-1.5 px-3 py-1.5 bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded text-white text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1" do %>
        <i class="fa-solid fa-user-plus text-xs" aria-hidden="true"></i>
        <span>Share</span>
      <% end %>

    </div>
  </div>

  <%# ===== CLOSED-BOARD BANNER =====
      A closed board is hidden from every listing but still renders normally by
      direct URL — this is the only thing that tells you which state you're in,
      and (for the owner) the only route back. warn-100/warn-700, matching the
      app's existing inline-notice treatment (see devise/registrations/edit):
      this is "attention", not an error, so it stays clear of danger crimson,
      and Reopen is a real action so it's brand.

      NOT enforced read-only in v1 — the board's cards and lists are still fully
      editable from here. See the arc note; that's a separate change spanning
      every mutating controller.

      Wraps rather than sits on one line (flex-wrap + min-w-0 on the text) so it
      doesn't overflow the 375px viewport this app ships chrome for. %>
  <% if @board.closed? %>
    <div class="flex-shrink-0 mx-4 mb-3 bg-warn-100 text-warn-700 rounded-md px-4 py-3 flex flex-wrap items-center gap-x-3 gap-y-2"
         role="status">
      <i class="fa-solid fa-box-archive shrink-0" aria-hidden="true"></i>
      <div class="flex-1 min-w-0 text-sm">
        <span class="font-semibold">This board is closed.</span>
        <span>It's hidden from your boards, search and planner. Nothing has been deleted.</span>
      </div>
      <% if @board.owner?(current_user) %>
        <%= button_to reopen_board_path(@board),
            method: :patch,
            form: { class: "m-0 shrink-0" },
            class: "bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-3 py-1.5 rounded cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2" do %>
          Reopen board
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# ===== LISTS ROW (existing) ===== %>
  <div id="board_lists" class="flex-1 flex space-x-4 px-4 pb-4 overflow-x-auto" data-controller="list-sort">

    <%# Render the list columns %>
    <%= render @lists %>

    <%# Add new list button (same column style) %>
    <%= render "boards/new_list_form", board: @board %>

    <%# Archived items link (matches the Add new list style) %>
    <%= render "boards/archived_link", board: @board %>

  </div>

  <%= render "boards/shortcuts_overlay" %>
</div>
