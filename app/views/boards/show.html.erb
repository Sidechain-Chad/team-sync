<%= turbo_stream_from @board %>

<div class="h-screen bg-blue-600 overflow-x-auto flex flex-col">

  <%# ===== BOARD HEADER ===== Trello-style title + dropdown trigger.
      Uses the existing dropdown Stimulus controller (toggle / outside-click).
      The chevron rotates when open via group-hover-style state on the button. %>
  <div class="flex-shrink-0 px-4 pt-4 pb-3">
    <div class="relative inline-block"
         data-controller="dropdown"
         data-action="click@document->dropdown#hide">

      <button type="button"
              data-action="click->dropdown#toggle"
              class="group flex items-center gap-2 text-white font-bold text-lg px-2 py-1 rounded-md hover:bg-white/15 transition-colors">
        <span><%= @board.name %></span>
        <i class="fa-solid fa-chevron-down text-[10px] opacity-80 group-hover:opacity-100"></i>
      </button>

      <%# Menu — hidden until toggle. Pinned to the button's lower-left edge. %>
      <div data-dropdown-target="menu"
           class="hidden absolute left-0 top-full mt-2 w-72 bg-white rounded-lg shadow-2xl ring-1 ring-black/5 z-40 overflow-hidden">

        <div class="px-4 py-3 border-b border-gray-200">
          <h3 class="text-sm font-semibold text-gray-800">Board menu</h3>
        </div>

        <div class="py-1">
          <%# Edit board name + cover %>
          <%= link_to edit_board_path(@board),
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-100 transition-colors" do %>
            <i class="fa-solid fa-pen-to-square text-gray-500 w-4 text-center"></i>
            <span>Edit board details</span>
          <% end %>

          <%# Members — same edit page, just scrolled to the members section %>
          <%= link_to edit_board_path(@board, anchor: "members"),
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-100 transition-colors" do %>
            <i class="fa-solid fa-user-group text-gray-500 w-4 text-center"></i>
            <span>Members</span>
          <% end %>

          <%# Archived items — re-uses the existing archive page %>
          <%= link_to archive_board_path(@board),
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-100 transition-colors" do %>
            <i class="fa-solid fa-box-archive text-gray-500 w-4 text-center"></i>
            <span>Archived items</span>
          <% end %>
        </div>

        <%# Destructive action separated by a divider, styled red. %>
        <div class="py-1 border-t border-gray-200">
          <%= link_to board_path(@board),
              data: { turbo_method: :delete, turbo_confirm: "Delete this entire board and all cards? This cannot be undone." },
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors" do %>
            <i class="fa-solid fa-trash w-4 text-center"></i>
            <span>Delete board</span>
          <% end %>
        </div>

      </div>
    </div>
  </div>

  <%# ===== LISTS ROW (existing) ===== %>
  <div id="board_lists" class="flex-1 flex space-x-4 px-4 pb-4 overflow-x-auto" data-controller="list-sort">

    <%# Render the list columns %>
    <%= render @lists %>

    <%# Add new list button (same column style) %>
    <%= render "boards/new_list_form", board: @board %>

    <%# Archived items link (matches the Add new list style) %>
    <%= render "boards/archived_link", board: @board %>

  </div>
</div>
