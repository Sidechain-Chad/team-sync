<div class="canvas-golden min-h-screen">
  <div class="flex gap-8 px-4 py-10">

    <%= render "sidebar", starred_boards: @starred_boards %>

    <div class="max-w-5xl mx-auto flex-1 min-w-0">

      <div class="flex justify-between items-center mb-8">
        <h1 class="font-display text-3xl font-bold text-ink-700">My Workspaces</h1>
        <%= link_to "New Board", new_board_path, class: "bg-brand-600 text-white px-4 py-2 rounded-md hover:bg-brand-700 font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2" %>
      </div>

      <% if @owned_boards.empty? && @shared_boards.empty? %>
        <p class="text-ink-500 mb-6">You don't have any boards yet — create your first one below to get started.</p>
      <% end %>

      <%= render "recently_viewed", recent_boards: @recent_boards %>

      <%= render "starred_section", starred_boards: @starred_boards %>

      <div class="mb-10">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-700 mb-4 border-b border-line pb-2">
          <i class="fa-solid fa-user text-ink-300"></i> Created by me
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">

          <%= link_to new_board_path, class: "group block h-40 border-2 border-dashed border-line rounded-lg flex flex-col items-center justify-center hover:border-brand-700 hover:bg-brand-100 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2" do %>
            <div class="h-10 w-10 rounded-full bg-surface-200 group-hover:bg-brand-100 flex items-center justify-center mb-2 transition">
              <i class="fa-solid fa-plus text-ink-300 group-hover:text-brand-600" aria-hidden="true"></i>
            </div>
            <span class="text-ink-500 font-medium group-hover:text-brand-700">Create new board</span>
          <% end %>

          <% @owned_boards.each do |board| %>
            <%= render "board_card", board: board %>
          <% end %>
        </div>
      </div>

      <% if @shared_boards.present? %>
        <div>
          <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-700 mb-4 border-b border-line pb-2">
            <i class="fa-solid fa-users text-ink-300"></i> Guest Workspaces
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
            <% @shared_boards.each do |board| %>
              <%= render "board_card", board: board %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Closed boards entry for narrow viewports. The sidebar carries this
          link on lg+, but it's `hidden lg:flex` — without this, a closed board
          would be unreachable on mobile, and reopening is the whole point of
          keeping it reachable. `lg:hidden` so exactly one of the two shows at
          any width. %>
      <div class="mt-10 pt-4 border-t border-line lg:hidden">
        <%= link_to closed_boards_path,
            class: "inline-flex items-center gap-2 text-sm font-medium text-ink-500 hover:text-brand-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2 rounded" do %>
          <i class="fa-solid fa-box-archive text-ink-300" aria-hidden="true"></i>
          Closed boards
        <% end %>
      </div>

    </div>
  </div>
</div>
