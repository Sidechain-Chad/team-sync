<div class="bg-gray-50 min-h-screen">
  <div class="max-w-5xl mx-auto py-10 px-4">

    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">My Workspaces</h1>
      <%= link_to "New Board", new_board_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2" %>
    </div>

    <% if @owned_boards.empty? && @shared_boards.empty? %>
      <p class="text-gray-500 mb-6">You don't have any boards yet — create your first one below to get started.</p>
    <% end %>

    <% if @starred_boards.present? %>
      <div class="mb-10">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-700 mb-4 border-b border-gray-200 pb-2">
          <i class="fa-solid fa-star text-yellow-400"></i> Starred
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <% @starred_boards.each do |board| %>
            <%= render "board_card", board: board %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="mb-10">
      <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-700 mb-4 border-b border-gray-200 pb-2">
        <i class="fa-solid fa-user text-gray-400"></i> Created by me
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">

        <%= link_to new_board_path, class: "group block h-40 border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center justify-center hover:border-blue-500 hover:bg-blue-50 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2" do %>
          <div class="h-10 w-10 rounded-full bg-gray-100 group-hover:bg-blue-100 flex items-center justify-center mb-2 transition">
            <i class="fa-solid fa-plus text-gray-400 group-hover:text-blue-600" aria-hidden="true"></i>
          </div>
          <span class="text-gray-500 font-medium group-hover:text-blue-700">Create new board</span>
        <% end %>

        <% @owned_boards.each do |board| %>
          <%= render "board_card", board: board %>
        <% end %>
      </div>
    </div>

    <% if @shared_boards.present? %>
      <div>
        <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-700 mb-4 border-b border-gray-200 pb-2">
          <i class="fa-solid fa-users text-gray-400"></i> Guest Workspaces
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <% @shared_boards.each do |board| %>
            <%= render "board_card", board: board %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>
