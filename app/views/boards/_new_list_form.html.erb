<%# Trello-style add-list trigger. Same translucent column treatment as
    the Archived items link so both sit as matched siblings at the right
    end of the lists row. On focus, expands into a white input field. %>
<div class="flex-shrink-0 w-72" id="new_list_form">
  <%= form_with(model: [board, List.new], class: "p-0") do |f| %>
    <%= f.text_field :name,
        placeholder: "+ Add another list",
        class: "w-full bg-white/20 hover:bg-white/30 backdrop-blur-sm rounded-xl shadow-sm border-0 text-white placeholder-white font-semibold text-sm px-3 py-2.5 text-left focus:ring-0 focus:bg-white focus:text-gray-800 focus:placeholder-gray-400 transition-colors duration-150 ease-out cursor-pointer focus:cursor-text",
        autocomplete: "off" %>

    <%= f.submit class: "hidden" %>
  <% end %>
</div>
