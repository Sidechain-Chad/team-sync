<%# Board cover: avatar variant if attached, else a deterministic gradient
    from board_cover_gradient_classes. Shared by _board_card and the
    board-switcher modal so their covers can't drift apart. %>
<div class="<%= height_class %> <%= board.avatar.attached? ? "bg-surface-200" : "bg-gradient-to-br #{board_cover_gradient_classes(board)}" %>">
  <% if board.avatar.attached? %>
    <%= image_tag board_tile_url(board), class: "w-full h-full object-cover" %>
  <% end %>
</div>
