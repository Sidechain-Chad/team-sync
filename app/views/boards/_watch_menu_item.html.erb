<%# Per-user board watch toggle, in the board-title dropdown menu alongside
    Activity / Archived items. Same link-with-turbo_method shape as Close
    board / Delete board below in this same menu (a real navigation-free PATCH
    from a plain link, not a button_to form) — Turbo's own Accept header still
    negotiates the turbo_stream format below, so only this one menu item swaps
    in place. %>
<% watching = board.watched_by?(current_user) %>
<%= link_to toggle_watch_board_path(board),
    id: dom_id(board, :watch_menu_item),
    data: { turbo_method: :patch },
    class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors",
    aria: { pressed: watching.to_s } do %>
  <i class="<%= watching ? 'fa-solid' : 'fa-regular' %> fa-eye text-ink-500 w-4 text-center" aria-hidden="true"></i>
  <span><%= watching ? "Stop watching" : "Watch board" %></span>
<% end %>
