<%= turbo_frame_tag dom_id(checklist_item) do %>
  <div class="flex items-center gap-3 group">
    <%# Deliberately NO autosubmit_once_value here — do not add it. This is the
        one autosubmit call site with a single trigger (change, no blur, no
        Enter), so it has no double-submit to fix, and toggling the checkbox
        twice in a row is two legitimate changes. A one-shot guard would swallow
        the second toggle. That's why `once` is opt-in rather than the default. %>
    <%= form_with model: [checklist_item.checklist.card, checklist_item.checklist, checklist_item],
        method: :patch,
        data: { turbo_frame: dom_id(checklist_item), controller: "autosubmit" },
        class: "flex items-center gap-3 w-full" do |f| %>
      <%= f.check_box :completed,
          data: { action: "change->autosubmit#submit" },
          class: "h-4 w-4 rounded border-line text-brand-600 focus:ring-brand-700",
          aria: { label: "Mark \"#{checklist_item.content}\" as #{checklist_item.completed? ? 'incomplete' : 'complete'}" } %>
      <span class="text-sm <%= checklist_item.completed? ? 'line-through text-ink-300' : 'text-ink-700' %> flex-1">
        <%= checklist_item.content %>
      </span>
    <% end %>
    <%= button_to card_checklist_checklist_item_path(checklist_item.checklist.card, checklist_item.checklist, checklist_item),
        method: :delete,
        form: { class: "m-0", data: { turbo_frame: dom_id(checklist_item) } },
        class: "opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 text-ink-300 hover:text-danger-600 transition-opacity bg-transparent border-0 cursor-pointer rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1",
        title: "Delete item",
        aria: { label: "Delete item" } do %>
      <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
    <% end %>
  </div>
<% end %>
