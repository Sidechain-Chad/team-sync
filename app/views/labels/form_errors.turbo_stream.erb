<% card = @card %>
<% frame_id = @label.new_record? ? "new_label_row" : "label_row_#{@label.id}" %>
<%= turbo_stream.replace frame_id do %>
  <div class="p-2 bg-danger-50 border border-danger-600/25 rounded text-xs text-danger-fg">
    Could not save label: <%= @label.errors.full_messages.to_sentence %>
  </div>
  <%= render "cards/label_form", board: @board, label: @label, card: card %>
<% end %>
