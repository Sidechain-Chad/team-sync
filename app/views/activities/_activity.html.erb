<div class="flex gap-3 text-sm mb-4 automated-activity" data-activity-toggle-target="item">
  <div class="h-8 w-8 rounded-full <%= avatar_soft_classes(activity.user) %> flex items-center justify-center shrink-0 font-bold border">
    <%= activity.user&.initials || "?" %>
  </div>
  <div class="flex flex-col">
    <div class="flex items-baseline gap-2">
      <span class="font-bold text-gray-800"><%= activity.user&.display_name || "Deleted User" %></span>
      <span class="text-[11px] text-gray-500"><%= time_ago_in_words(activity.created_at) %> ago</span>
    </div>
    <div class="text-gray-600 mt-1">
      <%= activity.message %>
    </div>
  </div>
</div>
