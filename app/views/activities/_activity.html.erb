<div class="flex gap-3 text-sm mb-4 automated-activity" data-activity-toggle-target="item">
  <%= render "shared/avatar", user: activity.user, size: "h-8 w-8", text_size: "", css_class: "shrink-0 border" %>
  <div class="flex flex-col">
    <div class="flex items-baseline gap-2">
      <span class="font-bold text-ink-700"><%= activity.user&.display_name || "Deleted User" %></span>
      <span class="text-[11px] text-ink-500"><%= time_ago_in_words(activity.created_at) %> ago</span>
    </div>
    <div class="text-ink-500 mt-1">
      <%= activity.message %>
    </div>
  </div>
</div>
