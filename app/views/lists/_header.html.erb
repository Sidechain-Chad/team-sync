<%= turbo_frame_tag dom_id(list, :header) do %>
  <div class="flex justify-between items-center mb-2 handle cursor-grab hover:bg-surface-200 rounded py-1 px-2 transition group">

    <%# 1. The Title (Clicking it activates Edit Mode) %>
    <div class="flex-1">
      <%= link_to list.name, edit_list_path(list), class: "font-display font-semibold text-ink-700 block w-full", style: "text-decoration: none;" %>
    </div>

    <%# 2. The Delete Button (Only visible on hover, or on keyboard focus) %>
    <div class="opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition">
      <%= button_to list_path(list), method: :delete, class: "text-ink-300 hover:text-danger-600 bg-transparent border-0 cursor-pointer p-1 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1", form: { style: "display:inline-block;" }, data: { turbo_confirm: "Delete this list?" }, title: "Delete list", aria: { label: "Delete list" } do %>
        <i class="fa-solid fa-trash text-xs" aria-hidden="true"></i>
      <% end %>
    </div>

  </div>
<% end %>
