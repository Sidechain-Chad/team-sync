<%# Fallback template for lists#create (the controller renders its stream
    inline, so this is only reached if that inline render is ever removed).
    It must NOT insert the new list: insertion is broadcast to the board's
    stream (ListsController#broadcast_list_insert) and the actor is
    subscribed to that same stream. Resetting the form is the actor-only
    part, so it's all that belongs here. %>
<%= turbo_stream.replace "new_list_form" do %>
  <%= render partial: "boards/new_list_form", locals: { board: @board } %>
<% end %>
