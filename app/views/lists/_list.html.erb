<%# Trello-style list: shrinks to content, caps at ~75vh and scrolls
    inside when there are too many cards. Uses self-start so each list
    sits at its natural height instead of stretching to match siblings. %>
<div class="w-72 flex-shrink-0 self-start bg-surface-200 rounded-xl p-2 mr-3 flex flex-col max-h-[calc(100vh-180px)] shadow-sm" id="<%= dom_id(list) %>" data-id="<%= list.id %>">

  <%# --- HEADER --- %>
  <%= render "lists/header", list: list %>

  <%# --- CARDS LIST + ADD A CARD trigger --- %>
  <div id="list_<%= list.id %>_cards"
       class="flex-1 overflow-y-auto min-h-[50px] space-y-2"
       data-controller="drag"
       data-drag-url-value="/cards/:id/move"
       data-list-id="<%= list.id %>">

    <% list.active_cards.each do |card| %>
      <%= render card %>
    <% end %>

    <%= turbo_frame_tag "list_#{list.id}_new_card" do %>
      <%= link_to new_list_card_path(list),
          class: "flex items-center gap-2 w-full p-2 text-ink-500 hover:bg-surface-200 rounded text-sm font-medium transition-colors" do %>
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Add a card</span>
      <% end %>
    <% end %>

  </div>

</div>
