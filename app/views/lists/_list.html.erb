<%# Trello-style list: shrinks to content, caps at ~75vh and scrolls
    inside when there are too many cards. Uses self-start so each list
    sits at its natural height instead of stretching to match siblings. %>
<div class="w-72 flex-shrink-0 self-start bg-surface-200 rounded-xl p-2 mr-3 flex flex-col max-h-[calc(100vh-180px)] shadow-sm" id="<%= dom_id(list) %>" data-id="<%= list.id %>">

  <%# --- HEADER --- %>
  <%= render "lists/header", list: list %>

  <%# --- CARDS LIST + ADD A CARD trigger --- %>
  <div id="list_<%= list.id %>_cards"
       class="list-cards-scroll flex-1 overflow-y-auto min-h-[50px] space-y-3 relative"
       data-controller="drag gap-insert"
       data-drag-url-value="/cards/:id/move"
       data-list-id="<%= list.id %>"
       data-gap-insert-list-id-value="<%= list.id %>"
       data-gap-insert-create-url-value="<%= list_cards_path(list) %>">

    <% list.active_cards.each do |card| %>
      <%= render card %>
    <% end %>

    <%= turbo_frame_tag "list_#{list.id}_new_card" do %>
      <%= link_to new_list_card_path(list),
          class: "flex items-center gap-2 w-full p-2 text-ink-500 hover:bg-surface-200 rounded text-sm font-medium transition-colors" do %>
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Add a card</span>
      <% end %>
    <% end %>

    <%# --- GAP INSERTER (Trello-style "insert here") ---
        A single absolutely-positioned overlay, not a per-gap strip: it has
        no data-id, so SortableJS's `draggable: '[data-id]'` filter ignores
        it entirely (same trick the "Add a card" trigger above already
        relies on) and gap_insert_controller.js excludes it from its own
        gap math the same way. It's moved via style.top to whichever gap
        is currently hovered, so nothing about turbo-stream re-renders or
        drag index math ever has to account for it. %>
    <div class="absolute left-0 right-0 z-20 hidden pointer-events-none"
         data-gap-insert-target="inserter">
      <div class="relative h-0">
        <div class="absolute inset-x-0 top-0 border-t-2 border-dashed border-brand-400 -translate-y-1/2"></div>
        <button type="button"
                class="pointer-events-auto absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 h-6 w-6 rounded-full bg-surface-0 text-brand-fg shadow-sm flex items-center justify-center cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-1"
                aria-label="Add a card here"
                data-action="click->gap-insert#insertHere">
          <i class="fa-solid fa-plus text-[10px]" aria-hidden="true"></i>
        </button>
      </div>
    </div>

  </div>

</div>
