<%= render "account/shell", active: :cards, title: "Cards" do %>

  <% if @cards.any? %>
    <div class="flex items-center justify-end gap-1 mb-3" role="group" aria-label="Sort cards">
      <span class="text-xs text-ink-500 mr-1">Sort:</span>
      <%= link_to "Due date", account_cards_path(sort: "due"),
          class: "text-xs font-medium px-2.5 py-1 rounded-md transition-colors #{@sort == "due" ? "bg-brand-100 text-brand-600" : "text-ink-500 hover:bg-surface-100"}",
          "aria-current": (@sort == "due" ? "true" : nil) %>
      <%= link_to "Recently updated", account_cards_path(sort: "updated"),
          class: "text-xs font-medium px-2.5 py-1 rounded-md transition-colors #{@sort == "updated" ? "bg-brand-100 text-brand-600" : "text-ink-500 hover:bg-surface-100"}",
          "aria-current": (@sort == "updated" ? "true" : nil) %>
    </div>
  <% end %>

  <% if @cards.empty? %>
    <div class="bg-white rounded-lg shadow-sm border border-line text-center py-12">
      <i class="fa-solid fa-address-card text-5xl text-ink-300 mb-4" aria-hidden="true"></i>
      <p class="text-ink-500">You're not assigned to any cards.</p>
      <p class="text-sm text-ink-300 mt-1">Cards you're added to as a member will show up here.</p>
    </div>
  <% else %>

    <%# Table — md+. Below md this collapses to stacked rows (same markup,
        just laid out as a card list instead of a grid, via responsive
        utility classes rather than two separate templates). %>
    <div class="bg-white rounded-lg shadow-sm border border-line overflow-hidden">
      <div class="hidden md:grid grid-cols-[1fr_auto_auto_auto_auto] gap-4 px-4 py-2.5 border-b border-line text-xs font-bold text-ink-500 uppercase tracking-wide">
        <span>Card</span>
        <span>List</span>
        <span>Labels</span>
        <span>Due</span>
        <span>Board</span>
      </div>

      <div class="divide-y divide-line">
        <% @cards.each do |card| %>
          <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto_auto_auto] gap-2 md:gap-4 md:items-center px-4 py-3 hover:bg-surface-50 transition-colors">

            <%# Card — complete indicator + title %>
            <%= link_to card_path(card), data: { turbo_frame: "modal" }, class: "flex items-center gap-2 min-w-0 no-underline text-inherit" do %>
              <% if card.completed? %>
                <i class="fa-solid fa-circle-check text-success-600 text-sm flex-shrink-0" title="Completed" aria-hidden="true"></i>
              <% else %>
                <i class="fa-regular fa-circle text-ink-300 text-sm flex-shrink-0" aria-hidden="true"></i>
              <% end %>
              <span class="text-sm font-medium text-ink-700 truncate"><%= card.title %></span>
            <% end %>

            <%# List %>
            <div class="text-xs text-ink-500">
              <span class="md:hidden font-bold uppercase tracking-wide mr-1">List:</span><%= card.list.name %>
            </div>

            <%# Labels %>
            <div class="flex flex-wrap gap-1">
              <%= render "cards/label_pills", card: card %>
            </div>

            <%# Due %>
            <div>
              <%= render "cards/due_pill", card: card %>
            </div>

            <%# Board — small cover swatch + name %>
            <%= link_to board_path(card.list.board), class: "flex items-center gap-2 min-w-0 no-underline text-inherit" do %>
              <%= render "boards/cover", board: card.list.board, height_class: "h-6 w-9 rounded flex-shrink-0" %>
              <span class="text-xs text-ink-500 truncate"><%= card.list.board.name %></span>
            <% end %>

          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
