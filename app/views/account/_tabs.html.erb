<%# Horizontal tab row — below lg only. Four links, not a drawer (per the
    brief: this is a small enough set that a collapsing menu would be
    overkill). Scrolls horizontally rather than wrapping at very narrow
    widths (375px). %>
<nav aria-label="Personal Settings" class="lg:hidden flex items-center gap-1 border-b border-line mb-6 overflow-x-auto">
  <% account_nav_links.each do |link| %>
    <% is_active = active == link[:key] %>
    <%= link_to link[:label], link[:path],
        class: "px-3 py-2.5 text-sm font-medium whitespace-nowrap border-b-2 -mb-px transition-colors #{is_active ? "border-brand-600 text-brand-fg" : "border-transparent text-ink-500 hover:text-ink-700"}",
        "aria-current": (is_active ? "page" : nil) %>
  <% end %>
</nav>
