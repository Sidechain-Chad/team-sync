<%# Global top nav — Trello-style. Renders on every authenticated page
    via the application layout. Skips the Devise sign-in/sign-up screens
    (no current_user there) the same way the bottom nav does. %>
<% return unless user_signed_in? %>

<header class="h-14 bg-nav-bg text-nav-fg flex items-center px-4 gap-3 ring-1 ring-white/10 relative z-menu">

  <%# ===== LEFT: logo / wordmark — links home ===== %>
  <%= link_to root_path,
      class: "flex items-center gap-2 px-2 py-1 rounded hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1",
      data: { turbo: false } do %>
    <i class="fa-solid fa-table-columns text-brand-400 text-sm" aria-hidden="true"></i>
    <span class="font-display font-bold text-white text-base tracking-tight">TeamSync</span>
  <% end %>

  <%# Spacer pushes search to center, actions to right %>
  <div class="flex-1"></div>

  <%# ===== CENTER: search ===== Two stacked Stimulus controllers on the
       wrapper: `dropdown` for open/close visibility, `search` for the
       debounced fetch. They run in parallel — no conflict. %>
  <div class="relative w-[640px] max-w-[50vw]"
       data-controller="dropdown search"
       data-search-url-value="<%= search_path %>"
       data-action="click@document->dropdown#hide">

    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-ink-300 text-xs pointer-events-none" aria-hidden="true"></i>

    <input type="text"
           placeholder="Search"
           aria-label="Search"
           aria-haspopup="true"
           aria-expanded="false"
           data-search-target="input"
           data-dropdown-target="trigger"
           data-action="focus->dropdown#open click->dropdown#open input->search#query"
           class="w-full h-8 pl-8 pr-3 rounded bg-white/10 hover:bg-white/15 focus:bg-surface-0 focus:text-ink-900 placeholder-ink-300 focus:placeholder-ink-300 text-sm outline-none ring-1 ring-white/10 focus:ring-2 focus:ring-brand-700 transition-colors">

    <div data-dropdown-target="menu"
         class="hidden absolute left-0 top-full mt-2 w-96 bg-surface-0 rounded-lg shadow-2xl ring-1 ring-hairline z-50 overflow-hidden text-ink-700">

      <%# Initial render: recent boards inline (no fetch on page load).
          Once the user types, the search controller swaps in
          /search?q=... which returns the <turbo-frame id="search_results">
          fragment. %>
      <%= turbo_frame_tag "search_results", data: { search_target: "frame" } do %>
        <%# open_boards, matching SearchController#index's blank-query branch —
            this is the same list, just rendered inline on page load. %>
        <%= render "search/recent",
            recent_boards: current_user.open_boards.order(updated_at: :desc).limit(5) %>
      <% end %>
    </div>
  </div>

  <%# Spacer between center search and right action cluster %>
  <div class="flex-1"></div>

  <%# ===== RIGHT: action cluster ===== %>

  <%# Create button — Trello-style dropdown. Single option for now since
      Workspaces / Templates aren't features here yet, but the shape is
      ready for them. %>
  <div class="relative"
       data-controller="dropdown"
       data-action="click@document->dropdown#hide">

    <button type="button"
            data-dropdown-target="trigger"
            data-action="click->dropdown#toggle"
            aria-haspopup="true"
            aria-expanded="false"
            class="flex items-center gap-1.5 h-8 px-3 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1">
      Create
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute right-0 top-full mt-2 w-72 bg-surface-0 rounded-lg shadow-2xl ring-1 ring-hairline z-50 overflow-hidden text-ink-700">

      <div class="px-4 py-3 border-b border-line">
        <h3 class="text-sm font-semibold">Create</h3>
      </div>

      <div class="py-1">
        <%= link_to new_board_path,
            class: "flex items-start gap-3 px-4 py-3 hover:bg-surface-200 transition-colors" do %>
          <i class="fa-solid fa-table-columns text-ink-500 mt-0.5 w-4 text-center" aria-hidden="true"></i>
          <div>
            <div class="text-sm font-semibold text-ink-700">Create board</div>
            <div class="text-xs text-ink-500 mt-0.5">A board is made up of cards ordered on lists.</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Notifications bell — matches the filter/bolt/plug pattern on the
      board header (icon + dropdown). The badge is always rendered (one
      unread-count query per page load); the feed itself is a lazy
      turbo-frame so it's only fetched when the bell actually opens.
      Hidden below `sm`: the fixed-width logo/search/create/avatar cluster
      already fills a 375px viewport, so this and Help collapse first. %>
  <div class="relative hidden sm:block"
       data-controller="dropdown"
       data-action="click@document->dropdown#hide">

    <button type="button"
            data-dropdown-target="trigger"
            data-action="click->dropdown#toggle"
            class="relative h-11 w-11 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors text-nav-fg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1"
            title="Notifications"
            aria-label="Notifications"
            aria-haspopup="true"
            aria-expanded="false">
      <i class="fa-regular fa-bell text-sm" aria-hidden="true"></i>
      <%= render "notifications/badge", count: current_user.notifications.unread.count %>
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute right-0 top-full mt-2 w-80 bg-surface-0 rounded-lg shadow-2xl ring-1 ring-hairline z-50 overflow-hidden text-ink-700">
      <turbo-frame id="notifications_list" src="<%= notifications_path %>" loading="lazy">
        <div class="px-4 py-3 border-b border-line">
          <h3 class="text-sm font-semibold">Notifications</h3>
        </div>
        <div class="px-4 py-12 text-center">
          <i class="fa-solid fa-spinner fa-spin text-2xl text-ink-300" aria-hidden="true"></i>
        </div>
      </turbo-frame>
    </div>
  </div>

  <%# Help — "Help center" links to the real /help help centre (HelpController).
      "Send feedback" is still a stub; no destination exists for it yet.
      Hidden below `sm` for the same overflow reason as Notifications above. %>
  <div class="relative hidden sm:block"
       data-controller="dropdown"
       data-action="click@document->dropdown#hide">

    <button type="button"
            data-dropdown-target="trigger"
            data-action="click->dropdown#toggle"
            class="h-11 w-11 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors text-nav-fg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1"
            title="Help"
            aria-label="Help"
            aria-haspopup="true"
            aria-expanded="false">
      <i class="fa-regular fa-circle-question text-sm" aria-hidden="true"></i>
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute right-0 top-full mt-2 w-64 bg-surface-0 rounded-lg shadow-2xl ring-1 ring-hairline z-50 overflow-hidden text-ink-700">
      <div class="px-4 py-3 border-b border-line">
        <h3 class="text-sm font-semibold">Help</h3>
      </div>
      <div class="py-1">
        <%= link_to help_index_path, class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors" do %>
          <i class="fa-regular fa-circle-question text-ink-500 w-4 text-center" aria-hidden="true"></i>
          <span>Help center</span>
        <% end %>
        <a href="#" class="flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors">
          <i class="fa-regular fa-paper-plane text-ink-500 w-4 text-center" aria-hidden="true"></i>
          <span>Send feedback</span>
        </a>
        <%# Board-only: the shortcuts overlay + keyboard controller (see
            boards/show.html.erb, boards/_shortcuts_overlay.html.erb) only
            render on the board canvas, so this item would be a dead
            control anywhere else. Opens the SAME overlay `?` toggles —
            dispatches a window CustomEvent the board-canvas element picks
            up via its own data-action (shortcuts:open@window->keyboard#openHelp);
            no second copy of the overlay, no new toggle logic. %>
        <% if controller_name == "boards" && action_name == "show" %>
          <button type="button"
                  data-controller="shortcuts-launcher"
                  data-action="click->dropdown#close click->shortcuts-launcher#open"
                  class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-200 transition-colors text-left cursor-pointer">
            <i class="fa-solid fa-keyboard text-ink-500 w-4 text-center" aria-hidden="true"></i>
            <span class="flex-1">Keyboard shortcuts</span>
            <kbd class="inline-flex items-center justify-center min-w-[1.75rem] px-1.5 h-6 rounded border border-line bg-surface-200 text-ink-700 text-xs font-mono font-semibold">?</kbd>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%# Profile avatar — real dropdown. Account header (name/email) + log out.
      Photo when attached, falls back to the shared initials chip. %>
  <div class="relative ml-1"
       data-controller="dropdown"
       data-action="click@document->dropdown#hide">

    <button type="button"
            data-dropdown-target="trigger"
            data-action="click->dropdown#toggle"
            class="group h-11 w-11 flex items-center justify-center rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1"
            title="<%= current_user.display_name %>"
            aria-label="Account menu for <%= current_user.display_name %>"
            aria-haspopup="true"
            aria-expanded="false">
      <%# The ring/clip lives on this inner span, not the button: the button is
          padded out to the 44×44 minimum tap target, and putting the ring there
          too would float a 44px circle around a 32px avatar. %>
      <span class="h-8 w-8 rounded-full overflow-hidden flex items-center justify-center ring-2 ring-white/20 group-hover:ring-white/40 transition">
        <%= render "shared/avatar", user: current_user, size: "h-8 w-8", text_size: "text-[11px]" %>
      </span>
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute right-0 top-full mt-2 w-72 bg-surface-0 rounded-lg shadow-2xl ring-1 ring-hairline z-50 overflow-hidden text-ink-700">

      <%# Account header — Trello uses uppercase "Account" eyebrow above
          the name/email block. %>
      <div class="px-4 py-3 border-b border-line">
        <p class="text-[10px] font-bold text-ink-500 uppercase tracking-wider mb-2">Account</p>
        <div class="flex items-center gap-3">
          <%= render "shared/avatar", user: current_user, size: "h-10 w-10", text_size: "text-xs", css_class: "flex-shrink-0" %>
          <div class="min-w-0">
            <div class="text-sm font-semibold truncate"><%= current_user.display_name %></div>
            <div class="text-xs text-ink-500 truncate"><%= current_user.email %></div>
          </div>
        </div>
      </div>

      <%# Personal Settings — Profile / Activity / Cards / Settings.
          Same four destinations as the account/_sidebar and account/_tabs
          partials (account_nav_links), just rendered as menu rows here
          instead of nav links. %>
      <div class="py-1">
        <% account_nav_links.each do |link| %>
          <%= link_to link[:path],
              class: "flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-100 transition-colors" do %>
            <i class="<%= link[:icon] %> text-ink-500 w-4 text-center" aria-hidden="true"></i>
            <span><%= link[:label] %></span>
          <% end %>
        <% end %>
      </div>

      <%# Appearance — Light / Dark / Match system. Lives here rather than on
          the Settings page (where notification preferences live) to match
          Trello, and because a theme is the one preference you want to flip
          while looking at the thing it changes.

          Plain buttons driven by theme_controller, NOT a form: the change is
          applied to <html> client-side for an instant repaint and persisted
          with a background fetch, so there is nothing to submit and nothing to
          navigate to. See the controller for why that split matters.

          radiogroup / radio, NOT the menuitem-radio role. DropdownAriaTest bans
          the whole menuitem* family app-wide and is right to: those roles are
          only valid inside a menu-role container, and these dropdowns
          deliberately have none (they contain forms, which that role forbids).
          An orphaned menuitem-radio is worse for assistive tech than no role at
          all. radiogroup is valid standalone and is the precise semantic for "pick
          exactly one of three" — and unlike the menu roles, its keyboard
          contract is small enough to actually honour, which theme_controller
          does (arrow keys + roving tabindex). %>
      <div class="py-1 border-t border-line"
           data-controller="theme"
           data-theme-url-value="<%= account_theme_path %>">
        <p class="px-4 pt-2 pb-1 text-[10px] font-bold text-ink-500 uppercase tracking-wider"
           id="appearance-label">Appearance</p>
        <div role="radiogroup" aria-labelledby="appearance-label">
          <% [
               { value: "light",  label: "Light",        icon: "fa-regular fa-sun" },
               { value: "dark",   label: "Dark",         icon: "fa-regular fa-moon" },
               { value: "system", label: "Match system", icon: "fa-solid fa-circle-half-stroke" }
             ].each do |option| %>
            <% selected = current_theme == option[:value] %>
            <%# Roving tabindex: only the checked option is in the tab order, and
                arrow keys move between them. That is the radiogroup contract —
                three separate tab stops would make tabbing past the menu take
                three presses. %>
            <button type="button"
                    role="radio"
                    aria-checked="<%= selected %>"
                    tabindex="<%= selected ? 0 : -1 %>"
                    data-theme-target="option"
                    data-action="click->theme#select keydown->theme#navigate"
                    data-theme-theme-param="<%= option[:value] %>"
                    class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-surface-100 transition-colors text-left cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-inset">
              <i class="<%= option[:icon] %> text-ink-500 w-4 text-center" aria-hidden="true"></i>
              <span class="flex-1"><%= option[:label] %></span>
              <%# Rendered for every row and hidden with `invisible` rather than
                  `hidden`, so the rows keep identical widths and the checkmark
                  can be toggled without reflowing the menu. aria-hidden because
                  aria-checked already carries this to assistive tech — the icon
                  is the sighted-user version of the same fact. %>
              <i class="fa-solid fa-check text-brand-fg text-xs <%= "invisible" unless selected %>"
                 data-theme-check
                 aria-hidden="true"></i>
            </button>
          <% end %>
        </div>
      </div>

      <%# Log out — Devise session destroy. button_to so we get a real
          form with CSRF + DELETE method, no Turbo data-method shim. %>
      <div class="py-1 border-t border-line">
        <%= button_to destroy_user_session_path,
            method: :delete,
            form: { data: { turbo: false } },
            class: "w-full flex items-center gap-3 px-4 py-2.5 text-sm text-ink-700 hover:bg-danger-50 hover:text-danger-fg transition-colors text-left" do %>
          <i class="fa-solid fa-arrow-right-from-bracket text-ink-500 w-4 text-center" aria-hidden="true"></i>
          <span>Log out</span>
        <% end %>
      </div>
    </div>
  </div>

</header>
