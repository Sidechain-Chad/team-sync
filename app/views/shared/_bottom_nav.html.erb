<%# Persistent bottom nav + side panel system. Only renders for signed-in
    users. The side-panel Stimulus controller handles open/close state and
    swaps content into the turbo-frame. %>
<% return unless user_signed_in? %>

<div data-controller="side-panel"
     data-side-panel-open-value="false"
     data-side-panel-current-panel-value="">

  <%# ===== BACKDROP — semi-transparent overlay, click to close ===== %>
  <div data-side-panel-target="backdrop"
       data-action="click->side-panel#closeFromBackdrop"
       class="hidden fixed inset-0 bg-black/30 z-30"></div>

  <%# ===== SLIDING PANEL on the LEFT ===== %>
  <div data-side-panel-target="panel"
       class="fixed top-0 left-0 bottom-0 w-[340px] bg-white shadow-2xl z-40
              transform -translate-x-full transition-transform duration-200 ease-out
              flex flex-col">

    <%# The frame is empty by default. Setting its src loads the panel
        content (e.g. /planner/sidebar) and Turbo renders the response
        with matching turbo_frame_tag id. %>
    <%= turbo_frame_tag "side_panel_frame",
        data: { side_panel_target: "frame" },
        class: "flex-1 overflow-y-auto" do %>
      <%# Empty initially %>
    <% end %>
  </div>

  <%# ===== BOTTOM NAV BAR ===== %>
  <div class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50">
    <div class="flex items-center bg-gray-900 text-gray-200 rounded-full shadow-lg ring-1 ring-white/10 px-2 py-1.5 gap-1">

      <%# Board — closes any open panel and ensures we're on the board view %>
      <%= link_to boards_path,
          class: "flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium transition hover:bg-white/10" do %>
        <i class="fa-solid fa-table-columns text-xs"></i>
        <span>Board</span>
      <% end %>

      <%# Planner — opens left sidebar with agenda. button (not link) so
          Stimulus can intercept without navigation. %>
      <button type="button"
              data-panel-name="planner"
              data-panel-url="<%= planner_panel_path %>"
              data-action="click->side-panel#toggle"
              class="flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium transition hover:bg-white/10">
        <i class="fa-regular fa-calendar text-xs"></i>
        <span>Planner</span>
      </button>

      <%# Switch boards — opens centered modal via the existing modal frame %>
      <%= link_to switch_boards_path,
          data: { turbo_frame: "modal" },
          class: "flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium hover:bg-white/10 transition" do %>
        <i class="fa-solid fa-grip text-xs"></i>
        <span>Switch boards</span>
      <% end %>

    </div>
  </div>
</div>
