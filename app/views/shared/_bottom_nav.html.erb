<%# Bottom nav — renders on board#show AND boards#map. Both views are
    "looking at a board" and the nav lets users hop between them.
    Skip on every other page. %>
<% return unless user_signed_in? %>
<% return unless controller_name == "boards" && %w[show map].include?(action_name) %>

<div data-controller="side-panel"
     data-side-panel-open-value="false"
     data-side-panel-current-panel-value="">

  <%# ===== SLIDING PANEL on the LEFT — no backdrop ===== %>
  <div data-side-panel-target="panel"
       class="fixed top-14 left-0 bottom-0 w-[340px] bg-white shadow-xl z-30
              transform -translate-x-full transition-transform duration-200 ease-out
              flex flex-col border-r border-line">

    <%= turbo_frame_tag "side_panel_frame",
        data: { side_panel_target: "frame" },
        class: "flex-1 overflow-y-auto" do %>
      <%# Empty initially — populated when a panel button is clicked %>
    <% end %>
  </div>

  <%# ===== BOTTOM NAV BAR ===== %>
  <div class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50">
    <div class="flex items-center bg-ink-900 text-gray-200 rounded-full shadow-lg ring-1 ring-white/10 px-2 py-1.5 gap-1">

      <%# Board — links to board#show. Highlighted when you're already
          there; otherwise navigates back from the map view. %>
      <% on_board = (controller_name == "boards" && action_name == "show") %>
      <% if on_board %>
        <button type="button"
                data-action="click->side-panel#close"
                class="flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium transition bg-white/15 text-white hover:bg-white/20">
          <i class="fa-solid fa-table-columns text-xs"></i>
          <span>Board</span>
        </button>
      <% else %>
        <%= link_to board_path(@board),
            class: "flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium hover:bg-white/10 transition" do %>
          <i class="fa-solid fa-table-columns text-xs"></i>
          <span>Board</span>
        <% end %>
      <% end %>

      <button type="button"
              data-panel-name="planner"
              data-panel-url="<%= planner_panel_path %>"
              data-action="click->side-panel#toggle"
              class="flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium transition hover:bg-white/10">
        <i class="fa-regular fa-calendar text-xs"></i>
        <span>Planner</span>
      </button>

      <%# Map — full-page board map. Not a side panel because the map
          wants the whole viewport. Active state highlights when we're
          actually on /boards/:id/map. %>
      <% on_map = (controller_name == "boards" && action_name == "map") %>
      <%= link_to map_board_path(@board),
          class: "flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium transition #{on_map ? 'bg-white/15 text-white' : 'hover:bg-white/10'}" do %>
        <i class="fa-solid fa-map-location-dot text-xs"></i>
        <span>Map</span>
      <% end %>

      <%= link_to switch_boards_path,
          data: { turbo_frame: "modal" },
          class: "flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium hover:bg-white/10 transition" do %>
        <i class="fa-solid fa-grip text-xs"></i>
        <span>Switch boards</span>
      <% end %>

    </div>
  </div>
</div>
