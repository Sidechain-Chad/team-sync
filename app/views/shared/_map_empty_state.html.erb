<%# Friendly empty state for map views (planner map + per-board map) when
    there are zero located cards — replaces what would otherwise be a
    silently blank/empty map. Mirrors the archive empty-state pattern. %>
<div class="bg-surface-0 rounded-lg shadow-sm border border-line h-full flex flex-col items-center justify-center text-center gap-2 p-8">
  <i class="fa-solid fa-map-location-dot text-5xl text-ink-300"></i>
  <p class="font-medium text-ink-700">No locations yet</p>
  <p class="text-sm text-ink-500">Add a location to a card and it will appear here.</p>
</div>
