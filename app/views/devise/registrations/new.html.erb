<% footer = capture do %>
  Already have an account?
  <%= link_to "Sign in", new_session_path(resource_name), class: "hover:text-ink-900 transition-colors underline-offset-2 hover:underline font-semibold" %>
<% end %>

<%= render "devise/shared/auth_card",
           title: "Create your account",
           subtitle: "Get started with TeamSync. It's free.",
           footer_links: footer do %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>

    <div>
      <%= f.label :email, class: "block text-xs font-bold text-ink-700 uppercase tracking-wide mb-1.5" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "w-full px-3 py-2.5 bg-surface-50 focus:bg-surface-0 border border-line rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-700 focus:border-brand-700 transition" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-xs font-bold text-ink-700 uppercase tracking-wide mb-1.5" %>
      <%= f.password_field :password,
            autocomplete: "new-password",
            placeholder: "At least #{@minimum_password_length} characters",
            class: "w-full px-3 py-2.5 bg-surface-50 focus:bg-surface-0 border border-line rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-700 focus:border-brand-700 transition" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-ink-500 mt-1">Minimum <%= @minimum_password_length %> characters.</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-xs font-bold text-ink-700 uppercase tracking-wide mb-1.5" %>
      <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            placeholder: "••••••••",
            class: "w-full px-3 py-2.5 bg-surface-50 focus:bg-surface-0 border border-line rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-700 focus:border-brand-700 transition" %>
    </div>

    <%= f.submit "Create account", class: "w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-2.5 rounded-lg text-sm cursor-pointer shadow-sm transition-colors" %>
  <% end %>
<% end %>
