<% footer = capture do %>
  <%= link_to "Create an account", new_registration_path(resource_name), class: "hover:text-white transition-colors underline-offset-2 hover:underline" %>
  <span class="text-blue-300">·</span>
  <%= link_to "Forgot password?", new_password_path(resource_name), class: "hover:text-white transition-colors underline-offset-2 hover:underline" %>
<% end %>

<%= render "devise/shared/auth_card",
           title: "Welcome back",
           subtitle: "Sign in to your TeamSync account",
           footer_links: footer do %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>

    <div>
      <%= f.label :email, class: "block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "w-full px-3 py-2.5 bg-gray-50 focus:bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-xs font-bold text-gray-700 uppercase tracking-wide mb-1.5" %>
      <%= f.password_field :password,
            autocomplete: "current-password",
            placeholder: "••••••••",
            class: "w-full px-3 py-2.5 bg-gray-50 focus:bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer select-none">
        <%= f.check_box :remember_me, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
        Remember me
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg text-sm cursor-pointer shadow-sm transition-colors" %>
  <% end %>
<% end %>
