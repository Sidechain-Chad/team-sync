<%# Shared frame for sign-in / sign-up / forgot-password screens.
    Centers a single card on a TeamSync-blue background, mirrors the
    look of the rest of the app instead of dropping the user onto a
    bare white page. %>
<div class="min-h-screen bg-gradient-to-br from-scrim via-brand-700 to-brand-600 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <%# Brand header %>
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 bg-white/10 backdrop-blur-sm rounded-2xl mb-4 ring-1 ring-white/20">
        <i class="fa-solid fa-bolt-lightning text-white text-2xl"></i>
      </div>
      <h1 class="font-display text-3xl font-bold text-white">TeamSync</h1>
      <p class="text-brand-100 text-sm mt-1"><%= local_assigns[:tagline] || "Plan, track, ship together." %></p>
    </div>

    <%# Card body %>
    <div class="bg-surface-0 rounded-2xl shadow-2xl p-8">
      <h2 class="text-xl font-bold text-ink-900 mb-1"><%= title %></h2>
      <% if local_assigns[:subtitle].present? %>
        <p class="text-sm text-ink-500 mb-6"><%= subtitle %></p>
      <% else %>
        <div class="mb-6"></div>
      <% end %>

      <%= yield %>
    </div>

    <%# Footer links %>
    <% if local_assigns[:footer_links].present? %>
      <div class="text-center mt-6 text-sm text-brand-100 space-x-4">
        <%= footer_links %>
      </div>
    <% end %>
  </div>
</div>
