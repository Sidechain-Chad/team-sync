<%# Shared split-screen frame for sign-in / sign-up / forgot-password screens.
    The form panel is DOM-first (so `flex-col` naturally stacks it above the
    visual panel on narrow viewports) and the visual panel is DOM-second; on
    lg: and up, `flex-row-reverse` puts the DOM-second panel on the LEFT and
    the DOM-first one on the RIGHT, without needing separate `order-*`
    utilities. So: form first when stacked, visual panel on the left when
    side by side. %>
<div class="min-h-screen flex flex-col lg:flex-row-reverse">

  <%# ===== FORM PANEL ===== %>
  <div class="flex-1 flex items-center justify-center bg-surface-50 px-4 py-12">
    <div class="w-full max-w-md">
      <%# Brand header %>
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-brand-100 rounded-2xl mb-4">
          <i class="fa-solid fa-bolt-lightning text-brand-fg text-2xl" aria-hidden="true"></i>
        </div>
        <h1 class="font-display text-3xl font-bold text-ink-900">TeamSync</h1>
        <p class="text-ink-500 text-sm mt-1"><%= local_assigns[:tagline] || "Plan, track, ship together." %></p>
      </div>

      <%# Card body %>
      <div class="bg-surface-0 rounded-2xl shadow-2xl border border-line p-8">
        <h2 class="text-xl font-bold text-ink-900 mb-1"><%= title %></h2>
        <% if local_assigns[:subtitle].present? %>
          <p class="text-sm text-ink-500 mb-6"><%= subtitle %></p>
        <% else %>
          <div class="mb-6"></div>
        <% end %>

        <%= yield %>
      </div>

      <%# Footer links %>
      <% if local_assigns[:footer_links].present? %>
        <div class="text-center mt-6 text-sm text-ink-500 space-x-4">
          <%= footer_links %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ===== VISUAL PANEL =====
      Same brand gradient the old single-card background used, now confined
      to one panel instead of the whole page — scrim/brand-700/brand-600 are
      all pinned tokens (dark in both themes, see application.css), so this
      needs no dark-mode branching of its own, same as the nav and the
      sign-in gradient did before this change.

      Purely supplementary/decorative (real app screenshots, auto-cycling)
      — aria-hidden so a screen reader isn't read a slideshow of changing
      images while trying to fill in the form. Screenshots are LIGHT-MODE
      only, reused as-is in both themes: this panel's own backdrop never
      changes with the theme (see above), so a light screenshot framed
      against it reads the same regardless of which theme the visitor is
      signed into (or, signed out, has no stored preference for at all). %>
  <div class="relative overflow-hidden h-56 lg:h-auto lg:flex-1 bg-gradient-to-br from-scrim via-brand-700 to-brand-600" aria-hidden="true">
    <%
      auth_panel_slides = [
        { image: "board",       caption: "Boards and lists" },
        { image: "card_modal",  caption: "Comments and detail on every card" },
        { image: "planner",     caption: "Due dates on a calendar" }
      ]
    %>
    <% auth_panel_slides.each do |slide| %>
      <div class="auth-panel-slide absolute inset-0 flex flex-col items-center justify-center text-center px-6 lg:px-10">
        <%# Frame is the static border/shadow; overflow-hidden crops the
            <img> itself as it slowly scales, so the frame never stretches
            along with the photo. width fills the available panel width
            (bounded only by its own padding) and height follows from the
            aspect ratio, so this can never overflow the panel however wide
            or narrow it ends up. %>
        <div class="w-full max-w-xs h-28 lg:h-auto lg:max-w-none lg:aspect-[8/5] rounded-lg lg:rounded-xl border border-white/20 bg-white/10 shadow-xl lg:shadow-2xl overflow-hidden">
          <%= image_tag "auth_panel/#{slide[:image]}.jpg",
                class: "auth-panel-shot w-full h-full object-cover block",
                alt: "" %>
        </div>
        <p class="mt-2 lg:mt-4 text-white font-display text-sm lg:text-xl font-bold"><%= slide[:caption] %></p>
      </div>
    <% end %>
  </div>
</div>
