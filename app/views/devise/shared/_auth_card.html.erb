<%# Shared split-screen frame for sign-in / sign-up / forgot-password screens.
    The form panel is DOM-first (so `flex-col` naturally stacks it above the
    visual panel on narrow viewports) and the visual panel is DOM-second; on
    lg: and up, `flex-row-reverse` puts the DOM-second panel on the LEFT and
    the DOM-first one on the RIGHT, without needing separate `order-*`
    utilities. So: form first when stacked, visual panel on the left when
    side by side. %>
<div class="min-h-screen flex flex-col lg:flex-row-reverse">

  <%# ===== FORM PANEL ===== %>
  <div class="flex-1 flex items-center justify-center bg-surface-50 px-4 py-12">
    <div class="w-full max-w-md">
      <%# Brand header %>
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-brand-100 rounded-2xl mb-4">
          <i class="fa-solid fa-bolt-lightning text-brand-fg text-2xl" aria-hidden="true"></i>
        </div>
        <h1 class="font-display text-3xl font-bold text-ink-900">TeamSync</h1>
        <p class="text-ink-500 text-sm mt-1"><%= local_assigns[:tagline] || "Plan, track, ship together." %></p>
      </div>

      <%# Card body %>
      <div class="bg-surface-0 rounded-2xl shadow-2xl border border-line p-8">
        <h2 class="text-xl font-bold text-ink-900 mb-1"><%= title %></h2>
        <% if local_assigns[:subtitle].present? %>
          <p class="text-sm text-ink-500 mb-6"><%= subtitle %></p>
        <% else %>
          <div class="mb-6"></div>
        <% end %>

        <%= yield %>
      </div>

      <%# Footer links %>
      <% if local_assigns[:footer_links].present? %>
        <div class="text-center mt-6 text-sm text-ink-500 space-x-4">
          <%= footer_links %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ===== VISUAL PANEL =====
      Same brand gradient the old single-card background used, now confined
      to one panel instead of the whole page — scrim/brand-700/brand-600 are
      all pinned tokens (dark in both themes, see application.css), so this
      needs no dark-mode branching of its own, same as the nav and the
      sign-in gradient did before this change.

      Purely supplementary/decorative (four beats explaining what the app
      does, auto-cycling) — aria-hidden so a screen reader isn't read a
      slideshow of changing text while trying to fill in the form. %>
  <div class="relative overflow-hidden h-56 lg:h-auto lg:flex-1 bg-gradient-to-br from-scrim via-brand-700 to-brand-600" aria-hidden="true">
    <%
      auth_panel_slides = [
        { icon: "fa-table-columns",           headline: "Boards and lists",       body: "Organize your work into boards, then lists, then cards." },
        { icon: "fa-arrows-up-down-left-right", headline: "Drag cards to move them", body: "Move a card between lists as the work moves forward." },
        { icon: "fa-comments",                headline: "Work with your team",    body: "See comments and updates from your team as they happen." },
        { icon: "fa-calendar-days",           headline: "Plan by date",           body: "See due dates and card ranges together on a calendar." }
      ]
    %>
    <% auth_panel_slides.each do |slide| %>
      <div class="auth-panel-slide absolute inset-0 flex flex-col items-center justify-center text-center px-8 lg:px-16">
        <i class="fa-solid <%= slide[:icon] %> text-white text-3xl lg:text-4xl mb-3 lg:mb-4" aria-hidden="true"></i>
        <h3 class="font-display text-lg lg:text-2xl font-bold text-white mb-1 lg:mb-2"><%= slide[:headline] %></h3>
        <p class="text-white/80 text-sm lg:text-base max-w-xs lg:max-w-sm"><%= slide[:body] %></p>
      </div>
    <% end %>
  </div>
</div>
