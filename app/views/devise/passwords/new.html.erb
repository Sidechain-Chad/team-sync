<% footer = capture do %>
  <%= link_to "Back to sign in", new_session_path(resource_name), class: "hover:text-white transition-colors underline-offset-2 hover:underline" %>
<% end %>

<%= render "devise/shared/auth_card",
           title: "Reset your password",
           subtitle: "We'll email you a link to set a new one.",
           footer_links: footer do %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>

    <div>
      <%= f.label :email, class: "block text-xs font-bold text-ink-700 uppercase tracking-wide mb-1.5" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "w-full px-3 py-2.5 bg-surface-50 focus:bg-white border border-line rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-700 focus:border-brand-700 transition" %>
    </div>

    <%= f.submit "Send reset instructions", class: "w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-2.5 rounded-lg text-sm cursor-pointer shadow-sm transition-colors" %>
  <% end %>
<% end %>
