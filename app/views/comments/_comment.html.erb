<div id="<%= dom_id(comment) %>" class="flex gap-3 mb-4 group"> <%# Avatar %>
  <%= render "shared/avatar", user: comment.user, size: "h-8 w-8", text_size: "text-xs", css_class: "shrink-0", fallback_class: avatar_solid_classes(comment.user) %>

  <div class="flex-1">
    <div class="flex items-baseline gap-2">
      <span class="font-bold text-sm text-ink-700"><%= comment.user&.display_name || "Deleted User" %></span>
      <span class="text-xs text-ink-500"><%= time_ago_in_words(comment.created_at) %> ago</span>
    </div>

    <div class="text-sm text-ink-700 bg-white p-2 rounded-md shadow-sm border border-line mt-1 inline-block">
      <%= comment.content %>
    </div>

    <%# --- THE FIX IS HERE --- %>
    <%# We use (current_user rescue nil) to prevent crashing in background jobs %>
    <% if (current_user rescue nil) == comment.user && comment.user.present? %>
      <div class="mt-1 text-xs opacity-0 group-hover:opacity-100 transition-opacity">
        <%= link_to "Delete", card_comment_path(comment.card, comment),
            data: { turbo_method: :delete, turbo_confirm: "Delete?" },
            class: "text-danger-600/80 hover:text-danger-600 underline" %>
      </div>
    <% end %>
  </div>
</div>
