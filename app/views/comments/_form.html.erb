<%= turbo_frame_tag "new_comment_form" do %>
  <%# Attach controller and 'click@window' listener. mention-typeahead reads
      the board's active members from a data value here (no fetch, no new
      endpoint) — since the form is re-rendered wholesale via
      turbo_stream.replace("new_comment_form", ...) after every submit, the
      data-controller + value live on this same partial so the typeahead
      re-attaches on the fresh markup exactly like comment-form does. %>
  <%= form_with(model: [card, Comment.new],
      class: "relative group",
      data: {
        controller: "comment-form mention-typeahead",
        action: "click@window->comment-form#clickOutside",
        mention_typeahead_members_value: card.list.board.active_members.map(&:display_name).to_json
      }) do |f| %>

    <%= f.text_area :content,
        rows: 1,
        class: "w-full border border-line rounded-md py-2 px-3 text-sm bg-surface-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-700 shadow-sm transition-all placeholder-ink-300 resize-none min-h-10",
        placeholder: "Write a comment...",
        data: {
          comment_form_target: "input",
          mention_typeahead_target: "textarea",
          # mention-typeahead's keydown MUST come before comment-form's:
          # when the mention dropdown is open, its handler
          # stopImmediatePropagation()s on Enter/arrows/Esc so
          # comment-form#submitOnEnter never also fires on the same keypress.
          action: "focus->comment-form#expand input->mention-typeahead#onInput keydown->mention-typeahead#onKeydown keydown->comment-form#submitOnEnter blur->mention-typeahead#onBlur"
        }
    %>

    <%# Populated by mention-typeahead#render. z-modal-menu is the tier for
        popovers opened from inside a modal — it outranks the modal's own content.
        (It can't escape the modal's stacking context, and doesn't need to.) %>
    <ul data-mention-typeahead-target="dropdown"
        class="hidden absolute left-0 top-full mt-1 w-64 max-h-48 overflow-y-auto bg-white border border-line rounded-md shadow-xl z-modal-menu list-none p-1"></ul>

    <%# Toolbar (Contains the SEND BUTTON) %>
    <%# This starts hidden, but the controller reveals it when you click the input %>
    <div data-comment-form-target="toolbar" class="hidden mt-2 flex items-center gap-2">
       <%= f.submit "Send",
           class: "bg-brand-600 text-white px-3 py-1.5 rounded text-sm font-medium hover:bg-brand-700 cursor-pointer shadow-sm",
           data: { comment_form_target: "submitButton" } %>
    </div>

  <% end %>
<% end %>
